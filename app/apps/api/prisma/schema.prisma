}

/// Wave 1 People Management deepening pass, docs/.../14-employee-documents.md.
/// A flat, type-tagged document metadata registry — no file storage
/// integration (this app has none), no versioning/retention/legal-hold
/// machinery, and no digital-signature capability (the "digital signature"
/// catalog item stays fully deferred — there is no e-sign integration at all).
model EmployeeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// OfferLetter | Payslip | Certificate | IdProof | Contract | Other
  documentType String  @map("document_type")
  title        String
  referenceUrl String? @map("reference_url")

  /// Uploaded file, via the File Storage engine — preferred over referenceUrl,
  /// which stays only for pointing at an external link (e.g. a shared drive).
  fileId String?     @map("file_id") @db.Uuid
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Uploaded | Verified | Expired
  status String @default("Uploaded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_documents")
}

/// Part of "certifications, skills, languages" — the certifications half.
