// Staffsy data model.
// Column standard per docs/07-appendices/24 & 29: snake_case names, uuid PKs,
// TIMESTAMPTZ, tenant_id on every tenant-scoped table, soft delete via deleted_at.
// RLS policies live in the migration SQL (Prisma does not model them).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-plane table (no RLS): the tenant registry itself.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalEntities               LegalEntity[]
  departments                 Department[]
  employees                   Employee[]
  users                       User[]
  sessions                    Session[]
  otpChallenges               OtpChallenge[]
  leavePolicies               LeavePolicy[]
  leaveRequests               LeaveRequest[]
  notifications               Notification[]
  attendanceDays              AttendanceDay[]
  employeeCompensations       EmployeeCompensation[]
  payrollRuns                 PayrollRun[]
  payrollRunResults           PayrollRunResult[]
  requisitions                Requisition[]
  candidates                  Candidate[]
  applications                Application[]
  offers                      Offer[]
  onboardingCases             OnboardingCase[]
  onboardingTasks             OnboardingTask[]
  goals                       Goal[]
  appraisals                  Appraisal[]
  keyResults                  KeyResult[]
  competencies                Competency[]
  competencyAssessments       CompetencyAssessment[]
  checkIns                    CheckIn[]
  learningCourses             LearningCourse[]
  learningEnrollments         LearningEnrollment[]
  talentAssessments           TalentAssessment[]
  compensationReviewCycles    CompensationReviewCycle[]
  compensationReviewItems     CompensationReviewItem[]
  payoutPlanCycles            PayoutPlanCycle[]
  payoutPlanItems             PayoutPlanItem[]
  esopGrants                  EsopGrant[]
  expenseClaims               ExpenseClaim[]
  travelRequests              TravelRequest[]
  assets                      Asset[]
  assetAssignments            AssetAssignment[]
  companies                   Company[]
  orgUnits                    OrgUnit[]
  financialCenters            FinancialCenter[]
  reportingLines              ReportingLine[]
  jobFamilies                 JobFamily[]
  jobFunctions                JobFunction[]
  designations                Designation[]
  grades                      Grade[]
  positions                   Position[]
  workCalendars               WorkCalendar[]
  workCalendarDays            WorkCalendarDay[]
  workCalendarAssignments     WorkCalendarAssignment[]
  orgPolicies                 OrgPolicy[]
  personalDetails             PersonalDetail[]
  emergencyContacts           EmergencyContact[]
  identityDocuments           IdentityDocument[]
  bankAccounts                BankAccount[]
  taxProfiles                 TaxProfile[]
  employeeDocuments           EmployeeDocument[]
  employeeCertifications      EmployeeCertification[]
  employeeSkills              EmployeeSkill[]
  educationRecords            EducationRecord[]
  priorExperiences            PriorExperience[]
  assignmentHistories         EmployeeAssignmentHistory[]
  probationRecords            ProbationRecord[]
  salaryRevisions             SalaryRevision[]
  contractRenewals            ContractRenewal[]
  storedFiles                 StoredFile[]
  auditLogs                   AuditLog[]
  documentTemplates           DocumentTemplate[]
  generatedDocuments          GeneratedDocument[]
  numberSeries                NumberSeries[]
  systemSettings              SystemSetting[]
  accessReviewCycles          AccessReviewCycle[]
  accessReviewItems           AccessReviewItem[]
  backupRecords               BackupRecord[]
  importBatches               ImportBatch[]
  importBatchRows             ImportBatchRow[]
  goLiveChecklistItems        GoLiveChecklistItem[]
  mfaFactors                  MfaFactor[]
  delegations                 Delegation[]
  shiftDefinitions            ShiftDefinition[]
  shiftAssignments            ShiftAssignment[]
  rosterEntries               RosterEntry[]
  rosterSwapRequests          RosterSwapRequest[]
  timesheetEntries            TimesheetEntry[]
  overtimeRequests            OvertimeRequest[]
  leaveLedgerEntries          LeaveLedgerEntry[]
  payComponents               PayComponent[]
  employeePayComponents       EmployeePayComponent[]
  arrearEntries               ArrearEntry[]
  fnfCases                    FnfCase[]
  complianceObligations       ComplianceObligation[]
