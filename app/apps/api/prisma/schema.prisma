// Staffsy data model.
// Column standard per docs/07-appendices/24 & 29: snake_case names, uuid PKs,
// TIMESTAMPTZ, tenant_id on every tenant-scoped table, soft delete via deleted_at.
// RLS policies live in the migration SQL (Prisma does not model them).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform-plane table (no RLS): the tenant registry itself.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  legalEntities  LegalEntity[]
  departments    Department[]
  employees      Employee[]
  users          User[]
  sessions       Session[]
  otpChallenges  OtpChallenge[]
  leavePolicies  LeavePolicy[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]

  @@map("tenants")
}

/// Tenant-plane table (RLS enforced): first entity of the Org service.
model LegalEntity {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  country   String    @default("IN")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entities")
}

/// Org service, second sub-module. Spec: docs/08-submodule-specifications/01-organization-management/03-department.md
/// Phase 2 slice: code, name, single-level-or-deeper parent hierarchy, and a
/// simplified Active/Inactive status. The full spec's Draft/Restructuring/
/// Retired states, ownership assignments, and merge/split workflows are
/// deferred to a later organization-management pass.
model Department {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   String  @default("Active")

  parentDepartmentId String?     @map("parent_department_id") @db.Uuid
  parentDepartment   Department? @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// People Core service. Spec: docs/08-submodule-specifications/02-people-management/01-employee-master.md
/// Phase 2 "proving slice": the master record, org assignment, and the
/// documented lifecycle state enum. Deliberately deferred to later phases:
/// effective-dated assignment history (employee_assignment), duplicate
/// detection, rehire linkage, concurrent-employment policy, and sensitive
/// field masking/reveal workflows — all called out explicitly in the spec's
/// section 19 edge cases and section 3 detailed rules.
model Employee {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  employeeCode String  @map("employee_code")

  legalName     String    @map("legal_name")
  preferredName String?   @map("preferred_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  personalEmail String?   @map("personal_email")
  mobileNumber  String?   @map("mobile_number")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  managerId String?    @map("manager_id") @db.Uuid
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports   Employee[] @relation("EmployeeManager")

  /// Spec section 15 state machine: Draft, Pre-Active, Active, Suspended, Separated, Archived.
  status      String    @default("Draft")
  joiningDate DateTime? @map("joining_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  leaveRequests         LeaveRequest[] @relation("LeaveRequestEmployee")
  approvedLeaveRequests LeaveRequest[] @relation("LeaveRequestApprover")

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("employees")
}

/// Identity & Access, "RBAC v1" slice per docs/03-module-specifications/03-identity-access.md
/// and 08-.../03-identity-and-access/01-authentication.md. Deliberately
/// deferred: the full role/permission governance catalog (versioning,
/// publish/retire, SoD, certification — 04-roles.md, 05-permissions.md),
/// SSO/federation and full MFA enrollment (02-sso.md, 03-mfa.md —
/// Keycloak/OIDC per the tech-stack ADR, blocked on Docker availability),
/// delegation, service accounts, and lockout/step-up-auth policy. `roles`
/// is a plain string array standing in for the governed role catalog until
/// that pass exists. Login is OTP-only (see OtpChallenge below); passwordHash
/// stays nullable for a possible future password/service-account path.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String?  @map("password_hash")
  roles        String[] @default([])

  /// Spec section 14 state machine: Invited, Active, Locked, Suspended, Deprovisioned.
  status String @default("Active")

  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  sessions      Session[]
  otpChallenges OtpChallenge[]
  notifications Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Backs real session revocation (auth.session_revoked event, spec section 6)
/// rather than purely stateless JWTs — the JWT carries this row's id (`sid`)
/// and AuthGuard checks it hasn't been revoked or expired on every request.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

/// One-time-passcode login challenge. Shape follows the `mfa_challenge`
/// entity in 08-.../03-identity-and-access/03-mfa.md §6 (issued/expiry/
/// verification-status/attempt-count), reused here as the PRIMARY login
/// factor rather than a second factor on top of a password — an approved
/// pattern per 01-authentication.md §3 ("magic-link... enterprise
/// authentication pattern"). `codeHash` is bcrypt-hashed even in dev, so the
/// verify path never has to change when StaticDevOtpProvider is swapped for
/// a real SMS/email gateway (see auth/otp/otp-provider.ts).
model OtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @map("code_hash")
  /// email | sms, per the MFA spec's channel list. Only email is wired up.
  channel      String    @default("email")
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("otp_challenges")
}

/// Leave module, Phase 4 slice. Spec: docs/08-submodule-specifications/08-leave-management/01-leave-policies.md
/// Deliberately a fixed leave-type + flat annual entitlement, not the full
/// applicability-matrix/versioning/publish/simulation model the spec
/// describes — that governance layer is a later leave-management pass.
model LeavePolicy {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  /// Annual | Casual | Sick for this slice; spec section 3 lists many more types.
  leaveType  String  @map("leave_type")
  name       String
  annualDays Float   @map("annual_days")
  status     String  @default("Active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, leaveType])
  @@index([tenantId])
  @@map("leave_policies")
}

/// Spec: docs/08-submodule-specifications/08-leave-management/03-leave-approval.md
/// Phase 4 slice: single-level approval (requestor's direct manager only),
/// simplified state machine (Pending/Approved/Rejected/Cancelled — the
/// spec's Draft/Submitted/Sent-Back/Partially-Cancelled states are
/// deferred), and no delegation/escalation/team-overlap visibility.
/// Balance is NOT a stored ledger here — LeaveBalanceService computes it
/// live from Employee.joiningDate + this table's Approved rows, deferring
/// the persisted-ledger + BullMQ-accrual-job model in 02-leave-accrual.md
/// (no queue infrastructure exists yet — see tech-stack ADR).
model LeaveRequest {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  leaveType String   @map("leave_type")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  /// Inclusive calendar-day count computed at submission. Half-days,
  /// weekend/holiday exclusion, and sandwich rules are deferred.
  days      Float
  reason    String?

  /// Pending, Approved, Rejected, Cancelled.
  status String @default("Pending")

  approverId String?   @map("approver_id") @db.Uuid
  approver   Employee? @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, approverId])
  @@map("leave_requests")
}

/// In-app notification inbox, Phase 4 slice. Only leave-request lifecycle
/// events publish here for now; the full notification-catalog/channel model
/// (appendix 3, 16) is deferred.
model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid

  type     String
  title    String
  body     String
  linkPath String? @map("link_path")

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("notifications")
}
