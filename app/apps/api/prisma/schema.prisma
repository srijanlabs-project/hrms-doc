/// Wave 1 People Management deepening pass, consolidating 3 catalog items —
/// employment information (docs/.../03-employment-information.md, the
/// effective-dated assignment history explicitly deferred back in Phase 2),
/// promotion/demotion/transfer (docs/.../11-promotion-demotion-transfer.md),
/// and deputation/secondment — into one append-only, type-tagged ledger. No
/// separate approval-case/impact-analysis sub-entities: recording a movement
/// both snapshots the "from" state and applies the "to" state directly to
/// the live Employee record (department/manager/designation/grade), the same
/// direct-assignment pattern as the Org Management pass's org-assignment
/// endpoint, rather than a maker-checker workflow.
model EmployeeAssignmentHistory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("AssignmentHistoryEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Transfer | Promotion | Demotion | Deputation | Confirmation | Other
  changeType    String   @map("change_type")
  effectiveDate DateTime @map("effective_date") @db.Date

  fromDepartmentId  String? @map("from_department_id") @db.Uuid
  toDepartmentId    String? @map("to_department_id") @db.Uuid
  fromManagerId     String? @map("from_manager_id") @db.Uuid
  toManagerId       String? @map("to_manager_id") @db.Uuid
  fromDesignationId String? @map("from_designation_id") @db.Uuid
  toDesignationId   String? @map("to_designation_id") @db.Uuid
  fromGradeId       String? @map("from_grade_id") @db.Uuid
  toGradeId         String? @map("to_grade_id") @db.Uuid

  reason          String?
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_assignment_histories")
}

