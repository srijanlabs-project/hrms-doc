/// Foundation & Platform (E00) — File Storage engine. A real catalog gap: no
/// spec file names it, but every document/attachment field elsewhere in the
/// catalog (employee documents, identity documents, and future expense
/// receipts/asset photos/resumes) needs somewhere to actually store bytes
/// rather than a bare reference URL. Local-disk storage for this build;
/// storageKey is a relative path under the configured uploads root, kept
/// generic enough that swapping in an object-store adapter later wouldn't
/// change any consumer's contract.
model StoredFile {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  originalName     String  @map("original_name")
  mimeType         String  @map("mime_type")
  sizeBytes        Int     @map("size_bytes")
  storageKey       String  @map("storage_key")
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  identityDocuments       IdentityDocument[]
  employeeDocuments       EmployeeDocument[]
  generatedDocuments      GeneratedDocument[]
  complianceTasks         ComplianceTask[]
  certificationRecords    CertificationRecord[]
  externalWorkerDocuments ExternalWorkerDocument[]
  healthRecords           HealthRecord[]
  documentVersions        DocumentVersion[]
  backupRecords           BackupRecord[]

  @@index([tenantId])
  @@map("stored_files")
}

/// Foundation & Platform (E00) — Audit Engine. A real catalog gap: Security &
/// Governance (E29) lists "audit logs" as pending, and several modules
/// (Salary Revision, Org Policy, Exit) already needed a compliance trail for
/// significant state changes but each was quietly skipping it. One generic,
/// append-only log keyed by (entityType, entityId) rather than a
/// per-module history table for everything — modules that already have their
/// own rich history (EmployeeAssignmentHistory, ProbationRecord) keep those;
/// this is for the mutations that had no trail at all.
model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  actorUserId String @map("actor_user_id") @db.Uuid
  entityType  String @map("entity_type")
  entityId    String @map("entity_id") @db.Uuid
  action      String

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

/// W0·E29 Security and Governance — periodic access certification. A cycle
/// snapshots every Active user's current roles into one AccessReviewItem
/// each; a reviewer (org_admin/hr_ops) confirms or revokes per item. Revoking
/// has a real effect — it suspends the user, not just a paper trail — and
/// writes to the existing Audit Engine so the two new features tie together.
model AccessReviewCycle {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  periodLabel String @map("period_label")

  /// Open | Closed. Closing requires every item to be decided (no Pending left).
  status String @default("Open")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  items  AccessReviewItem[]

  @@index([tenantId])
  @@map("access_review_cycles")
}

model AccessReviewItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  cycleId String            @map("cycle_id") @db.Uuid
  cycle   AccessReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Snapshot of user.roles at cycle-creation time — the review target, immune
  /// to the user's roles changing mid-cycle.
  rolesSnapshot String[] @map("roles_snapshot")

  /// Pending | Confirmed | Revoked.
  decision         String    @default("Pending")
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@map("access_review_items")
}

/// W0·E30 DevOps and Operations — a JSON snapshot of core system-of-record
/// tables (org structure, people, leave, payroll), not a full pg_dump-parity
/// database backup: no replica/point-in-time-recovery infra exists in this
/// environment to make a full backup/restore meaningful, and shelling out to
/// pg_dump would be the first native-binary dependency in an otherwise
/// pure-Prisma codebase. Stored through the existing File Storage engine.
model BackupRecord {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  status       String  @default("Succeeded") // Running | Succeeded | Failed
  triggeredBy  String  @map("triggered_by") // Manual | Scheduled
  tableCounts  Json    @map("table_counts")
  errorMessage String? @map("error_message")

  fileId String?     @map("file_id") @db.Uuid
  file   StoredFile? @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("backup_records")
}

/// W0·E31 Implementation and Migration — a generic multi-entity import
/// engine (Employee, Department, LegalEntity, LeavePolicy today) that reuses
/// each module's existing create(dto) service rather than a parallel
/// per-entity bulk path, giving legacy-system data migration one configurable
/// surface instead of N bespoke ones. createdEntityId is a plain UUID, not a
/// Prisma relation — it points at whichever table entityType names, a
/// deliberately heterogeneous reference the rollback path resolves itself.
model ImportBatch {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  entityType String @map("entity_type")

  /// Committed | RolledBack. A dry-run validates and returns results but is
  /// never persisted as a batch — only real, committed imports get history.
  status            String @default("Committed")
  totalRows         Int    @map("total_rows")
  successCount      Int    @map("success_count")
  failureCount      Int    @map("failure_count")
  triggeredByUserId String @map("triggered_by_user_id") @db.Uuid

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rolledBackAt DateTime? @map("rolled_back_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  rows   ImportBatchRow[]

  @@index([tenantId])
  @@map("import_batches")
}

model ImportBatchRow {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  batchId  String      @map("batch_id") @db.Uuid
  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowIndex        Int     @map("row_index")
  success         Boolean
  errorMessage    String? @map("error_message")
  createdEntityId String? @map("created_entity_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, batchId])
  @@map("import_batch_rows")
}

/// A curated, admin-trackable checklist of onboarding/setup tasks — not a
/// full go-live sign-off/environment-handover workflow (no staging
/// environment or second system exists here to hand over between).
model GoLiveChecklistItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  label    String

  completed         Boolean   @default(false)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("go_live_checklist_items")
}

/// Foundation & Platform (E00) — Document Generation + Template engines,
/// treated as one pair since neither has an independent consumer yet.
/// bodyTemplate holds plain text with {{mergeField}} placeholders (employee/
/// org data only, no rich layout or PDF rendering) — the first real consumer
/// of the "Generate Letter" quick action stubbed since Phase 2.
model DocumentTemplate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String

  /// OfferLetter | ExperienceLetter | SalaryCertificate | BankAdvice | Other
  category     String
  bodyTemplate String @map("body_template")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  generatedDocuments GeneratedDocument[]

  @@index([tenantId])
  @@map("document_templates")
}

model GeneratedDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  templateId String           @map("template_id") @db.Uuid
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employeeId String           @map("employee_id") @db.Uuid
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId     String           @map("file_id") @db.Uuid
  file       StoredFile       @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  generatedByUserId String @map("generated_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("generated_documents")
}

/// Foundation & Platform (E00) — Number Series engine. Replaces the ad hoc
/// `NH-${count + 1}` string built inline in OfferService.convert() (a
/// count-based scheme that isn't race-safe under concurrent conversions)
/// with one configurable, atomically-incremented series per entity type,
/// reused for both employee codes and asset tags.
model NumberSeries {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Employee | Asset | ... — one row per entity type per tenant.
  entityType String @map("entity_type")
  prefix     String
  padding    Int    @default(4)
  nextValue  Int    @default(1) @map("next_value")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entityType])
  @@map("number_series")
}

/// W0·E28 Administration — generic tenant-scoped config store. Replaces
/// scattered hardcoded assumptions (default currency, fiscal year start,
/// date format, etc.) with an admin-editable key/value table, without
/// building the full dynamic-field/masters framework the spec envisions —
/// no current consumer needs per-tenant custom fields, so that stays deferred.
model SystemSetting {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  value       String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("system_settings")
}

/// Wave 1 Identity and Access deepening (03-mfa.md) — v1 slice: authenticator-
/// app (TOTP) factor only, no SMS/email/hardware-token/push factors, no
/// adaptive risk-based triggering, no break-glass bypass workflow. One factor
/// per user for now (spec allows several).
model MfaFactor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// TOTP only for v1.
  type         String @default("TOTP")
  secretBase32 String @map("secret_base32")

  /// PendingEnrollment | Active | Revoked
  status String @default("PendingEnrollment")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("mfa_factors")
}

/// Wave 1 Identity and Access deepening (06-delegation.md) — v1 slice: one
/// scope tag per delegation rather than a generic workflow-type/task-type
/// registry (no workflow engine exists to register against), no approval
/// step for the delegation itself, no SoD/conflict engine. Real effect: the
/// delegate can decide Leave/Expense/Travel requests routed to the delegator
/// while the delegation is Active and today falls in [startDate, endDate].
model Delegation {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  delegatorUserId String @map("delegator_user_id") @db.Uuid
  delegateUserId  String @map("delegate_user_id") @db.Uuid
  delegator       User   @relation("DelegationDelegator", fields: [delegatorUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  delegate        User   @relation("DelegationDelegate", fields: [delegateUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// LeaveApproval | ExpenseApproval | TravelApproval | All
  scope     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  /// Active | Revoked
  status          String @default("Active")
  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, delegateUserId])
  @@map("delegations")
}

/// Wave 2 W2·E07 Workforce Management, 03-shift-management.md. Collapses
/// shift_definition/shift_version/shift_break_rule/shift_rotation_pattern/
/// shift_rotation_member/shift_assignment/shift_override into two models:
/// this one (no Draft/Published/Superseded version state machine — edits
/// apply immediately) and ShiftAssignment (effective-dated, one active row
/// per employee). Rotation patterns, per-break-type detail, and multi-segment
/// split shifts are deferred — no real consumer yet to justify them.
model ShiftDefinition {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  code           String
  name           String
  /// "HH:mm" 24-hour local time
  startTime      String  @map("start_time")
  endTime        String  @map("end_time")
  crossMidnight  Boolean @default(false) @map("cross_midnight")
  plannedMinutes Int     @map("planned_minutes")
  graceMinutes   Int     @default(0) @map("grace_minutes")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  assignments   ShiftAssignment[]
  rosterEntries RosterEntry[]
  rotationSteps ShiftRotationStep[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("shift_definitions")
}

/// The employee's default/standing shift. RosterEntry (below) can override
/// it for a specific date; where no RosterEntry exists for a date, this is
/// the effective shift. One active (effectiveTo null) assignment per employee
/// is enforced in the service layer, not the database.
model ShiftAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  shiftId       String    @map("shift_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    ShiftDefinition @relation(fields: [shiftId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("shift_assignments")
}

/// Wave 2 W2·E07, 04-rostering.md + 07-workforce-scheduling.md — the two specs
/// describe the same underlying concept (date-level shift assignment across a
/// planning horizon, published for execution) so they're consolidated into one
/// model rather than built as two parallel entities. Collapses roster_plan/
/// roster_version/roster_entry/roster_coverage_rule/roster_publish_event plus
/// workforce_schedule/schedule_shift/schedule_assignment/schedule_constraint_result
/// into a single per-employee-per-date row with a Draft/Published status.
/// Coverage rules, skill/certification constraints, and demand forecasting are
/// deferred — no staffing-rules or forecasting engine exists to drive them
/// honestly; swap requests (RosterSwapRequest) are the one workflow built on top.
model RosterEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  shiftId    String   @map("shift_id") @db.Uuid
  date       DateTime @db.Date

  /// Draft | Published
  status String @default("Draft")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift        ShiftDefinition     @relation(fields: [shiftId], references: [id])
  swapRequests RosterSwapRequest[]

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("roster_entries")
}

/// A published roster entry's employee proposes a shift swap with a named
/// counterpart; the requester's manager (or org_admin/hr_ops) approves —
/// same assigned-approver-or-admin-override pattern used across Leave/Expense/
/// Travel. Approval reassigns the entry's employeeId to the counterpart.
model RosterSwapRequest {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  rosterEntryId         String    @map("roster_entry_id") @db.Uuid
  requestedByEmployeeId String    @map("requested_by_employee_id") @db.Uuid
  counterpartEmployeeId String    @map("counterpart_employee_id") @db.Uuid
  reason                String?
  /// Pending | Approved | Rejected | Withdrawn
  status                String    @default("Pending")
  decisionNote          String?   @map("decision_note")
  decidedByUserId       String?   @map("decided_by_user_id") @db.Uuid
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  rosterEntry RosterEntry @relation(fields: [rosterEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("roster_swap_requests")
}

/// Wave 2 W2·E07, 05-timesheets.md. Collapses timesheet_header/timesheet_entry/
/// timesheet_approval/timesheet_period/timesheet_exception into one
/// row-per-day-per-activity model. No project/client/cost-center master data
/// exists yet, so allocation is a free-text activity label, not a governed
/// project reference; period locking, dual (manager + project-manager)
/// approval, and billing/costing export are deferred.
model TimesheetEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  hours      Float
  activity   String

  /// Draft | Submitted | Approved | Rejected
  status          String    @default("Draft")
  approverId      String?   @map("approver_id") @db.Uuid
  decisionNote    String?   @map("decision_note")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId, date])
  @@map("timesheet_entries")
}

/// Wave 2 W2·E07, 06-overtime.md. Collapses overtime_policy/overtime_request/
/// overtime_result/overtime_approval/overtime_export_batch into a single
/// request+result row. Eligibility is open to all employees (no worker-
/// category/union policy engine exists); payableAmount is an estimate
/// (hourly-equivalent of EmployeeCompensation.monthlyBasic x 1.5), computed
/// on approval and informational only until Payroll (E09) is deepened enough
/// to actually consume it. Comp-off conversion is deferred.
model OvertimeRequest {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  date           DateTime @db.Date
  hoursRequested Float    @map("hours_requested")
  reason         String?

  /// Payable | CompOff — chosen by the employee at request time. CompOff credits
  /// the "Comp Off" leave balance via the existing Leave Ledger (E08) on approval
  /// instead of computing a payable amount; consuming it is just applying for
  /// "Comp Off" leave through the existing leave-request flow.
  settlementType      String @default("Payable") @map("settlement_type")
  compOffDaysCredited Float? @map("comp_off_days_credited")

  /// Pending | Approved | Rejected
  status          String    @default("Pending")
  approverId      String?   @map("approver_id") @db.Uuid
  payableAmount   Float?    @map("payable_amount")
  decisionNote    String?   @map("decision_note")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("overtime_requests")
}

/// Wave 2 W2·E08 Leave Management deepening, 02-leave-accrual.md. Deliberately
/// NOT a replacement for the live-computed entitlement in LeaveBalanceService
/// (prorateEntitlement already gives a correct, explainable accrual-to-date
/// figure with no queue infrastructure needed) — this is an additive
/// correction ledger for the two things that genuinely can't be computed
/// live: manual adjustments (with audit trail) and year-end carry-forward.
/// periodYear is the leave-year the entry affects (not necessarily the year
/// it was posted in), so carry-forward runs are idempotent per employee/
/// leave-type/year and the ledger reads naturally per year.
model LeaveLedgerEntry {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  leaveType  String @map("leave_type")
  periodYear Int    @map("period_year")

  /// Adjustment | CarryForward
  entryType  String  @map("entry_type")
  /// Signed — positive credits the balance, negative debits it.
  amountDays Float   @map("amount_days")
  reason     String?

  postedByUserId String @map("posted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   LeavePolicy @relation(fields: [tenantId, leaveType], references: [tenantId, leaveType])

  @@index([tenantId])
  @@index([tenantId, employeeId, leaveType, periodYear])
  @@map("leave_ledger_entries")
}

/// Wave 2 W2·E09 Payroll deepening, 02-pay-components.md. Collapses the
/// spec's pay_component/pay_component_version/pay_component_formula/
/// pay_component_mapping/pay_component_usage_reference/
/// pay_component_publish_request into one catalog row (no version history,
/// no formula engine, no GL/dependency mapping — no chart-of-accounts or
/// formula-authoring surface exists in this build). Two calculation methods
/// only: a flat monthly amount, or a percentage of prorated Basic.
model PayComponent {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  code              String
  name              String
  /// Earning | Deduction
  type              String
  /// FixedAmount | PercentOfBasic
  calculationMethod String  @map("calculation_method")
  /// Flat rupee amount for FixedAmount, or a fraction (0.1 = 10%) for PercentOfBasic.
  defaultValue      Float   @map("default_value")
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  assignments EmployeePayComponent[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("pay_components")
}

/// One active row per employee per component; value overrides the
/// component's defaultValue when set. No effective-dated version history —
/// changing an assignment just updates it in place, consistent with
/// EmployeeCompensation's own v1 simplification.
model EmployeePayComponent {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  employeeId     String  @map("employee_id") @db.Uuid
  payComponentId String  @map("pay_component_id") @db.Uuid
  value          Float?
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payComponent PayComponent @relation(fields: [payComponentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, payComponentId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_pay_components")
}

/// Wave 2 W2·E09 deepening, 04-arrears-and-retro-pay.md. Collapses
/// retro_pay_case/retro_pay_impacted_period/retro_pay_component_delta/
/// retro_pay_posting_log/retro_pay_statutory_adjustment into one lump-sum
/// row per trigger — no period-by-period component delta breakdown, no
/// statutory recomputation of historical periods, no difference-only vs
/// full-rebuild mode choice (always a simple gross-impact estimate). Real
/// trigger: SalaryRevisionService.apply() creates one Pending entry when its
/// effectiveDate falls inside an already-Processed/Approved/Closed payroll
/// period. PayrollRunService.process() consumes all of an employee's Pending
/// entries as a lump sum each time it (re)processes a run.
model ArrearEntry {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  employeeId   String  @map("employee_id") @db.Uuid
  /// SalaryRevision | LeaveEncashment — what created this lump sum.
  sourceType   String  @map("source_type")
  sourceId     String  @map("source_id") @db.Uuid
  description  String
  /// Signed — positive owed to the employee.
  amount       Float
  payrollRunId String? @map("payroll_run_id") @db.Uuid

  /// Pending | Included | Paid
  status String @default("Pending")

  postedByUserId String @map("posted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId, status])
  @@map("arrear_entries")
}

/// Wave 2 W2·E09 deepening, 07-full-and-final-settlement.md. Collapses
/// fnf_case/fnf_component_result/fnf_recovery_item/fnf_approval/
/// fnf_payment_instruction/fnf_recalculation_event into one row — no
/// component-level breakdown persisted beyond the three summed figures, no
/// recovery/waiver model (no loans/advances/asset-damage-billing module
/// exists to source recoveries from), no payment-channel integration. Real
/// calculation: final-month gross-to-net via the same computeGrossToNet used
/// by regular payroll runs, plus unused Annual-leave encashment via
/// LeaveBalanceService's existing formula, plus any of the employee's
/// still-Pending ArrearEntry rows (settled here since there's no future
/// payroll run left to include them in).
model FnfCase {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @unique @map("employee_id") @db.Uuid
  exitDate   DateTime @map("exit_date") @db.Date

  finalMonthNetPay Float @map("final_month_net_pay")
  leaveEncashment  Float @map("leave_encashment")
  arrearsIncluded  Float @map("arrears_included")
  /// Payment of Gratuity Act 1972: (last drawn monthly basic x 15 x years of service) / 26, only if service >= 5 years. 0 when ineligible.
  gratuityAmount   Float @default(0) @map("gratuity_amount")
  netPayable       Float @map("net_payable")

  /// Draft | Approved | Released
  status String @default("Draft")

  calculatedAt     DateTime  @default(now()) @map("calculated_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  releasedAt       DateTime? @map("released_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("fnf_cases")
}

/// Wave 2 W2·E10 Statutory and Compliance deepening, 05-compliance-calendar.md.
/// Collapses compliance_obligation/compliance_task_dependency/
/// compliance_escalation_rule into one catalog row — no dependency chains,
/// no maker-checker, no jurisdiction/legal-entity scoping (single-entity
/// tenant). Monthly frequency only: this ties directly back to the PF/ESIC/
/// TDS/PT figures the payroll calculator already produces every run — the
/// real gap being closed is "now here's the obligation to actually file/pay
/// them, tracked," not a generic multi-frequency scheduling engine.
model ComplianceObligation {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  code               String
  name               String
  /// PF | ESIC | TDS | PT | Custom
  category           String
  /// Day of the month following the covered period that this obligation is due.
  dueDayOfMonth      Int     @map("due_day_of_month")
  reminderDaysBefore Int     @default(3) @map("reminder_days_before")
  isActive           Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  tasks  ComplianceTask[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("compliance_obligations")
}

/// One instance per obligation per calendar month, generated idempotently by
/// ComplianceCalendarService.generateForTenant(). periodLabel ("YYYY-MM") is
/// the month the deadline falls in, not the period being filed for.
model ComplianceTask {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  obligationId String   @map("obligation_id") @db.Uuid
  periodLabel  String   @map("period_label")
  dueDate      DateTime @db.Date

  /// Open | Completed | Overdue | Waived
  status            String    @default("Open")
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  evidenceFileId    String?   @map("evidence_file_id") @db.Uuid
  note              String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  obligation   ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  evidenceFile StoredFile?          @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([tenantId, obligationId, periodLabel])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("compliance_tasks")
}

/// Tenant-wide statutory parameters for the three computed compliance checks
/// (minimum wages, labour welfare fund, statutory bonus) — one row per
/// tenant, like FlexBasketPolicy. Single-tier/flat-rate simplification
/// (matching the existing PT calculator's approach): real minimum-wage and
/// LWF rates vary by Indian state, but this v1 slice has no state-wise rate
/// table, so the tenant configures one applicable figure directly.
model StatutoryComplianceSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  minimumWageThreshold    Float @default(0) @map("minimum_wage_threshold")
  lwfEmployeeContribution Float @default(0) @map("lwf_employee_contribution")
  lwfEmployerContribution Float @default(0) @map("lwf_employer_contribution")
  lwfFrequencyMonths      Int   @default(6) @map("lwf_frequency_months")
  bonusEligibilityCeiling Float @default(0) @map("bonus_eligibility_ceiling")
  bonusPercent            Float @default(8.33) @map("bonus_percent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("statutory_compliance_settings")
}

/// Wave 2 W2·E27 Integration Platform, 02-webhooks.md. Collapses
/// webhook_secret_version/webhook_dead_letter into direct fields on the
/// subscription/delivery rows — no secret rotation history, no dead-letter
/// queue, one retry on failure rather than governed backoff. eventTypes
/// uses "*" as a wildcard matching every event; concrete event names are
/// whatever WebhookDispatchService.dispatch() is called with from real
/// mutation points (see that file's comment for the wired call sites).
model WebhookSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  url        String
  secret     String
  eventTypes String[] @map("event_types")
  isActive   Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

/// One row per delivery attempt (including the single retry) — not per
/// event, so a retried delivery shows as two rows, both visible in the log.
model WebhookDelivery {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  subscriptionId String  @map("subscription_id") @db.Uuid
  eventType      String  @map("event_type")
  payload        Json
  responseStatus Int?    @map("response_status")
  success        Boolean @default(false)
  errorMessage   String? @map("error_message")

  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, subscriptionId])
  @@map("webhook_deliveries")
}

/// Wave 4 W4·E15 Employee Experience, docs/03-module-specifications/15-employee-experience.md.
/// v1 slice: surveys and recognition only. Pulse surveys collapse into `type`
/// on Survey rather than a separate entity — a pulse survey is just a
/// Standard survey with a shorter/recurring cadence, no new mechanics.
/// Social feed, communities, events, wellness programs, the quote/culture
/// library, and AI-generated celebration cards all stay deferred: no
/// moderation/photo-consent/vendor-rewards infra exists in this build to
/// make any of them a real (non-cosmetic) feature yet.
model Survey {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  title       String
  description String?

  /// Standard | Pulse
  type        String  @default("Standard")
  isAnonymous Boolean @default(false) @map("is_anonymous")

  /// Draft | Published | Closed
  status          String    @default("Draft")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  closesAt        DateTime? @map("closes_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("surveys")
}

model SurveyQuestion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  surveyId String @map("survey_id") @db.Uuid
  text     String

  /// Rating | Text
  type      String @default("Rating")
  sortOrder Int    @default(0) @map("sort_order")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([tenantId, surveyId])
  @@map("survey_questions")
}

/// One row per employee per survey — enforces a single submission. employeeId
/// is always stored (needed to enforce the one-response-per-employee rule and
/// to notify late responders), but SurveyService never returns it in results
/// when the survey is anonymous.
model SurveyResponse {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  surveyId    String   @map("survey_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id])
  answers  SurveyAnswer[]

  @@unique([tenantId, surveyId, employeeId])
  @@index([tenantId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  responseId  String  @map("response_id") @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  ratingValue Int?    @map("rating_value")
  textValue   String? @map("text_value")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, responseId, questionId])
  @@index([tenantId])
  @@map("survey_answers")
}

/// Peer-to-peer kudos: any employee can recognize any other employee (not
/// gated behind a manager/admin approval workflow, unlike the spec's
/// "recognition approval workflow" — a small single-tenant deployment has no
/// real abuse signal yet to justify a moderation queue). `points` is tracked
/// but there is no redemption catalog — "rewards" per the spec stays a
/// deferred capability, not this running counter.
model Recognition {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  fromEmployeeId String @map("from_employee_id") @db.Uuid
  toEmployeeId   String @map("to_employee_id") @db.Uuid
  value          String
  message        String
  points         Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  fromEmployee Employee @relation("RecognitionFromEmployee", fields: [fromEmployeeId], references: [id])
  toEmployee   Employee @relation("RecognitionToEmployee", fields: [toEmployeeId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, toEmployeeId])
  @@map("recognitions")
}

/// Wave 4 W4·E19 Helpdesk and Case Management, docs/03-module-specifications/19-helpdesk-case-management.md.
/// The four spec queues (HR/IT/Admin/Finance helpdesk) collapse into one
/// `Ticket.queue` type tag rather than four parallel systems. The spec's
/// 7-state machine (Open/Assigned/InProgress/PendingUser/Escalated/
/// Resolved/Closed) collapses to 5 states with escalation as an `isEscalated`
/// overlay flag rather than a blocking state, since a ticket can be
/// InProgress and escalated at the same time — "Pending User" isn't tracked
/// separately (no distinct employee-response-required signal in this build).
/// `Service Agent`/`Queue Manager` collapse to org_admin/hr_ops, matching
/// every other module this pass — no separate agent role exists yet.
/// Employee relations and grievance management stays deferred: it needs its
/// own confidential/redacted handling, not just another queue value.
model Ticket {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// HR | IT | Admin | Finance
  queue       String
  category    String
  subject     String
  description String

  /// Low | Medium | High | Urgent
  priority String @default("Medium")

  /// Open | Assigned | InProgress | Resolved | Closed
  status          String  @default("Open")
  isEscalated     Boolean @default(false) @map("is_escalated")
  assignedAgentId String? @map("assigned_agent_id") @db.Uuid

  dueAt              DateTime? @map("due_at") @db.Timestamptz(6)
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  satisfactionRating Int?      @map("satisfaction_rating")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  employee      Employee        @relation("TicketRaiser", fields: [employeeId], references: [id])
  assignedAgent Employee?       @relation("TicketAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  comments      TicketComment[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("tickets")
}

/// isInternal comments (agent notes) are never returned to the raising employee — enforced in HelpdeskService, not the repository.
model TicketComment {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  ticketId     String  @map("ticket_id") @db.Uuid
  authorUserId String  @map("author_user_id") @db.Uuid
  body         String
  isInternal   Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId])
  @@map("ticket_comments")
}

model SlaPolicy {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  queue           String
  priority        String
  resolutionHours Int    @map("resolution_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, queue, priority])
  @@map("sla_policies")
}

model KnowledgeArticle {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  queue           String
  title           String
  body            String
  isPublished     Boolean @default(false) @map("is_published")
  createdByUserId String  @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, queue])
  @@map("knowledge_articles")
}

/// Wave 4 W4·E20 Contractor and External Workforce, docs/03-module-specifications/20-contractor-external-workforce.md.
/// "Agency" collapses into Vendor (no separate agency entity — an agency is
/// just a vendor whose workers are AgencyStaff). Assignment tracking (the
/// spec's external_worker_assignment entity) collapses into direct fields on
/// ExternalWorker rather than a separate historized table, matching the
/// position/grade-assignment collapse used for Employee in People
/// Management — no effective-dated assignment history yet. "Access control"
/// is a real grantedAt/revokedAt timestamp pair plus admin actions, not
/// integrated with any actual badge/access system (none exists in this build).
model Vendor {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  externalWorkers ExternalWorker[]

  @@unique([tenantId, name])
  @@map("vendors")
}

model ExternalWorker {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid

  fullName String  @map("full_name")
  email    String?

  /// Contractor | Consultant | AgencyStaff | Intern
  category String @default("Contractor")

  /// Draft | PendingApproval | Active | Expired | Suspended | Inactive
  status String @default("Draft")

  contractStartDate DateTime    @map("contract_start_date") @db.Date
  contractEndDate   DateTime    @map("contract_end_date") @db.Date
  departmentId      String?     @map("department_id") @db.Uuid
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  workLocation      String?     @map("work_location")

  accessGrantedAt DateTime? @map("access_granted_at") @db.Timestamptz(6)
  accessRevokedAt DateTime? @map("access_revoked_at") @db.Timestamptz(6)
  statusReason    String?   @map("status_reason")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                   @relation(fields: [tenantId], references: [id])
  vendor    Vendor                   @relation(fields: [vendorId], references: [id])
  documents ExternalWorkerDocument[]

  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@map("external_workers")
}

/// Compliance documents — reuses the File Storage engine (StoredFile) exactly
/// like EmployeeDocument does. isVerified stands in for the spec's
/// "compliance checklist" — an after-the-fact admin confirmation, not a
/// blocker on the worker's own status (mirrors CertificationRecord.verify()).
model ExternalWorkerDocument {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  externalWorkerId String @map("external_worker_id") @db.Uuid

  /// NDA | BackgroundCheck | IdProof | InsuranceCertificate | Other
  documentType String      @map("document_type")
  fileId       String?     @map("file_id") @db.Uuid
  file         StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  isVerified       Boolean   @default(false) @map("is_verified")
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  externalWorker ExternalWorker @relation(fields: [externalWorkerId], references: [id], onDelete: Cascade)

  @@index([tenantId, externalWorkerId])
  @@map("external_worker_documents")
}

/// Wave 4 W4·E21 Visitor and Workplace Management, docs/03-module-specifications/21-visitor-workplace-management.md.
/// Collapses visitor registration, gate pass, and check-in/out into one
/// state-machine entity — a gate pass IS the visitor record, not a separate
/// row. Meeting management collapses into room booking below (a booking IS
/// the meeting, no separate Meeting entity). No badge/QR hardware
/// integration exists in this build, so check-in/out are admin-recorded
/// actions, not device scans.
model Visitor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  fullName String  @map("full_name")
  company  String?
  phone    String?
  email    String?
  purpose  String?

  hostEmployeeId String   @map("host_employee_id") @db.Uuid
  scheduledAt    DateTime @map("scheduled_at") @db.Timestamptz(6)

  /// Requested | Approved | CheckedIn | CheckedOut | Cancelled | Expired
  status String @default("Requested")

  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  checkedInAt  DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt DateTime? @map("checked_out_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  hostEmployee Employee @relation(fields: [hostEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("visitors")
}

/// Desk, room, parking, cafeteria, and shuttle bookings collapse into one
/// generic type-tagged resource + booking pair — all five are structurally
/// identical (reserve a capacity-limited resource for a date). Date-level
/// granularity only, no intraday time slots, no waitlist.
model WorkplaceResource {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Desk | Room | Parking | Shuttle | Cafeteria
  type     String
  name     String
  location String?
  capacity Int     @default(1)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  bookings WorkplaceBooking[]

  @@index([tenantId])
  @@map("workplace_resources")
}

model WorkplaceBooking {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  resourceId  String   @map("resource_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  bookingDate DateTime @map("booking_date") @db.Date
  notes       String?

  /// Confirmed | Cancelled
  status String @default("Confirmed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  resource WorkplaceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, resourceId, bookingDate])
  @@map("workplace_bookings")
}

/// Wave 4 W4·E22 Health Safety and Wellness, docs/03-module-specifications/22-health-safety-wellness.md.
/// The spec's 5-state machine (Reported/UnderReview/ActionAssigned/Resolved/
/// Closed) collapses to 4 — "Action Assigned" folds into UnderReview's
/// investigationNotes field, since no separate corrective-action-tracking
/// entity exists in this v1 slice (matching the Helpdesk ticket's 7-to-5
/// state collapse).
model SafetyIncident {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  reportedByEmployeeId String   @map("reported_by_employee_id") @db.Uuid
  incidentDate         DateTime @map("incident_date") @db.Date
  location             String
  description          String

  /// Low | Medium | High | Critical
  severity String @default("Medium")

  /// Reported | UnderReview | Resolved | Closed
  status String @default("Reported")

  investigationNotes String?   @map("investigation_notes")
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  reportedByEmployee Employee @relation(fields: [reportedByEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("safety_incidents")
}

/// Safety audits, risk assessments, and emergency drills collapse into one
/// type-tagged entity — all three are structurally identical: assess a
/// location/activity on a date and record findings plus a risk rating.
model SafetyAssessment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Audit | RiskAssessment | Drill
  type                  String
  location              String
  assessedDate          DateTime @map("assessed_date") @db.Date
  conductedByEmployeeId String?  @map("conducted_by_employee_id") @db.Uuid
  findings              String?

  /// Low | Medium | High
  riskLevel String @default("Low") @map("risk_level")

  /// Scheduled | Completed
  status String @default("Scheduled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  conductedByEmployee Employee? @relation(fields: [conductedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("safety_assessments")
}

/// Occupational health reviews, medical checkups, and vaccinations collapse
/// into one type-tagged entity per employee — the same "flat record catalog"
/// shape already used for CertificationRecord.
model HealthRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String @map("employee_id") @db.Uuid

  /// MedicalCheckup | Vaccination | OccupationalHealthReview
  type String

  recordDate     DateTime  @map("record_date") @db.Date
  provider       String?
  notes          String?
  nextDueDate    DateTime? @map("next_due_date") @db.Date
  evidenceFileId String?   @map("evidence_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  evidenceFile StoredFile? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("health_records")
}

/// Simple admin-managed directory — the buildable slice of "emergency
/// response" in this environment: no real alerting channel (SMS/push/PA
/// system) exists to broadcast to, so this is the who-to-call reference
/// every employee can see, not an automated alert dispatcher.
model EmergencyResponseContact {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name     String
  role     String
  phone    String
  /// Fire | Medical | Security | Facilities | Other
  category String  @default("Other")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("emergency_response_contacts")
}

/// Wave 4 W4·E23 Communication Platform, docs/03-module-specifications/23-communication-platform.md.
/// Announcements, news, bulletin board, and campaigns all collapse into this
/// one type-tagged entity — a "campaign" is just an Announcement with a
/// broader `category`, and there's no per-channel dispatch mechanism to
/// justify separate entities. The spec's 6-state machine
/// (Draft/Scheduled/Sending/Sent/Failed/Archived) collapses to 3
/// (Draft/Published/Archived) since there is no actual async delivery
/// pipeline — publishing just makes it visible tenant-wide, it doesn't
/// dispatch anything. Email/SMS/push notifications/WhatsApp/Slack/Teams all
/// stay deferred — no real external gateway or collaboration-platform
/// integration exists in this build (same honest deferral as ERP/identity
/// provider integrations in the Integration Platform). This is a real
/// catalog gap fill: it replaces the hardcoded "Announcements" widget on the
/// home dashboard with genuine tenant-scoped data.
model Announcement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title String
  body  String

  /// Policy | Event | Holiday | General | Urgent
  category String @default("General")

  /// Draft | Published | Archived
  status String @default("Draft")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  comments AnnouncementComment[]

  @@index([tenantId, status])
  @@map("announcements")
}

/// Wave 1 W1·E05 Manager Self Service, closing the "transfers and promotions"
/// gap. Manager-initiated, mirroring the exact Proposed/Approved/Applied/
/// Rejected state machine already proven by SalaryRevision. On Apply, this
/// writes through the same EmployeeAssignmentHistory ledger and
/// Employee.applyAssignmentChange() the existing admin-only CareerService
/// "movement" flow already uses — no parallel history mechanism.
model TransferPromotionRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId        String   @map("employee_id") @db.Uuid
  employee          Employee @relation("TransferPromotionRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requestedByUserId String   @map("requested_by_user_id") @db.Uuid

  /// Transfer | Promotion | Demotion
  changeType String @map("change_type")

  toDepartmentId  String?      @map("to_department_id") @db.Uuid
  toDepartment    Department?  @relation(fields: [toDepartmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  toDesignationId String?      @map("to_designation_id") @db.Uuid
  toDesignation   Designation? @relation(fields: [toDesignationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  toGradeId       String?      @map("to_grade_id") @db.Uuid
  toGrade         Grade?       @relation(fields: [toGradeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  effectiveDate DateTime @map("effective_date") @db.Date
  reason        String

  /// Proposed | Approved | Applied | Rejected
  status String @default("Proposed")

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decisionNote    String?   @map("decision_note")
  appliedAt       DateTime? @map("applied_at") @db.Timestamptz(6)

  /// Wave 3 E11 gap closure ("promotions linkage"): a snapshot of the employee's
  /// most recent Finalized appraisal rating (calibratedRating if calibrated,
  /// else managerRating) at proposal time — the evidence that justified the
  /// change, frozen the same way CalibrationCase.originalRating is, since the
  /// live appraisal can change (or get calibrated) after this request is decided.
  latestAppraisalRating     Int? @map("latest_appraisal_rating")
  latestAppraisalPeriodYear Int? @map("latest_appraisal_period_year")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("transfer_promotion_requests")
}

/// Wave 3 E11 gap closure — Performance Improvement Plan. Objectives are a flat
/// checklist (mirrors OnboardingCase/OnboardingTask's case+tasks pattern) rather
/// than a separate milestone/scoring model; any periodic check-ins during the
/// PIP window just reuse the existing CheckIn model against the same
/// employee/manager pair, not a parallel cadence entity.
model PerformanceImprovementPlan {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reason    String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  /// Active | Completed | Extended | Failed
  status String @default("Active")

  outcomeNotes    String?   @map("outcome_notes")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  objectives PipObjective[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("performance_improvement_plans")
}

model PipObjective {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  pipId    String @map("pip_id") @db.Uuid

  title      String
  targetDate DateTime? @map("target_date") @db.Date

  /// NotStarted | Completed
  status      String    @default("NotStarted")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant                     @relation(fields: [tenantId], references: [id])
  pip    PerformanceImprovementPlan @relation(fields: [pipId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, pipId])
  @@map("pip_objectives")
}

/// Wave 3 E13 gap closure ("career planning") — an employee's own aspiration
/// document: a target designation/timeframe plus a flat action checklist,
/// mirroring PerformanceImprovementPlan/PipObjective's exact case-plus-
/// checklist pattern. Self-service by default (unlike PIP): the employee
/// creates and drives their own plan; their manager and org_admin/hr_ops get
/// read access plus the ability to add supporting actions, not to create
/// the plan itself. No unique constraint on employeeId — a new plan can be
/// started once an earlier one is Achieved or Cancelled, same as PIP allows
/// multiple cycles over time.
model CareerPlan {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  targetDesignationId String?      @map("target_designation_id") @db.Uuid
  targetDesignation   Designation? @relation(fields: [targetDesignationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  timeframeYears      Int?         @map("timeframe_years")
  developmentNotes    String?      @map("development_notes")

  /// Draft | Active | Achieved | Cancelled
  status String @default("Draft")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  actions CareerPlanAction[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("career_plans")
}

model CareerPlanAction {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  title String

  /// NotStarted | Completed
  status      String    @default("NotStarted")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  plan   CareerPlan @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, planId])
  @@map("career_plan_actions")
}

/// Wave 2 W2·E07 deepening gap-closure, 07-workforce-management (flexible hours
/// sub-capability — no dedicated deep-spec exists, folded in here). Mirrors
/// ShiftDefinition/ShiftAssignment's exact shape: a policy catalog plus an
/// effective-dated standing assignment. Compliance is evaluated against
/// self-reported check-in/check-out times on AttendanceDay (no punch-clock
/// capture exists in this build) — informational, not payroll-integrated.
model FlexibleHoursPolicy {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  name                 String
  /// "HH:mm" 24-hour local time — the window every assigned employee must be present for.
  coreStartTime        String  @map("core_start_time")
  coreEndTime          String  @map("core_end_time")
  requiredDailyMinutes Int     @map("required_daily_minutes")
  isActive             Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  assignments EmployeeFlexAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("flexible_hours_policies")
}

/// One active (effectiveTo null) assignment per employee, enforced in the
/// service layer exactly like ShiftAssignment.
model EmployeeFlexAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  policyId      String    @map("policy_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   FlexibleHoursPolicy @relation(fields: [policyId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_flex_assignments")
}

/// Wave 2 W2·E07 deepening gap-closure — the real "shift rotation" gap
/// ShiftDefinition's own v1 comment named ("no rotation patterns"). A pattern
/// is an ordered cycle of shifts, one per week; assigning an employee to a
/// pattern plus an anchor week lets ShiftRotationService.generateRoster()
/// materialize real RosterEntry rows for a date range via
/// RosterRepository.upsertEntry — reused exactly, no parallel roster-writing path.
model ShiftRotationPattern {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  cadenceWeeks Int     @map("cadence_weeks")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant                       @relation(fields: [tenantId], references: [id])
  steps       ShiftRotationStep[]
  assignments EmployeeRotationAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shift_rotation_patterns")
}

model ShiftRotationStep {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  patternId String @map("pattern_id") @db.Uuid
  /// 0-based position in the cycle — week 0, week 1, etc.
  weekIndex Int    @map("week_index")
  shiftId   String @map("shift_id") @db.Uuid

  tenant  Tenant               @relation(fields: [tenantId], references: [id])
  pattern ShiftRotationPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  shift   ShiftDefinition      @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, patternId, weekIndex])
  @@index([tenantId])
  @@map("shift_rotation_steps")
}

/// One active (effectiveTo null) rotation per employee, enforced in the
/// service layer exactly like ShiftAssignment. anchorWeekStart must be a Monday.
model EmployeeRotationAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  patternId       String    @map("pattern_id") @db.Uuid
  anchorWeekStart DateTime  @map("anchor_week_start") @db.Date
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pattern  ShiftRotationPattern @relation(fields: [patternId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_rotation_assignments")
}

/// Wave 2 W2·E08 deepening gap-closure — leave encashment while still in
/// service (distinct from the F&F-settlement encashment E09 already built for
/// exiting employees). Approval debits the leave balance via a signed
/// LeaveLedgerEntry Adjustment (same mechanism as a manual adjustment or
/// comp-off credit) and creates an ArrearEntry (sourceType "LeaveEncashment")
/// so the payout rides the existing lump-sum-claimed-by-next-payroll-run
/// mechanism — no parallel payout path.
model LeaveEncashmentRequest {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  leaveType  String @map("leave_type")
  days       Float

  /// Snapshot of EmployeeCompensation.monthlyBasic / 30 at request time.
  ratePerDay Float @map("rate_per_day")
  amount     Float

  reason String?

  /// Pending | Approved | Rejected
  status          String    @default("Pending")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy   LeavePolicy @relation(fields: [tenantId, leaveType], references: [tenantId, leaveType])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_encashment_requests")
}

/// Wave 2 W2·E09 deepening gap-closure, 09-payroll (loans and advances — no
/// dedicated deep-spec, folded in here). Flat-installment repayment, no
/// interest computation. Requested by the employee; approving disburses
/// (sets outstandingBalance = principal, status Active) in one step — no
/// separate disbursement stage. PayrollRunService reads the live installment
/// (min(monthlyInstallment, outstandingBalance)) into otherDeductions on
/// every process() (idempotent — a pure read), and PayrollRunService.approve()
/// commits the real balance decrement once per run, auto-closing at zero.
model LoanAdvance {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Loan | Advance — same flat-installment mechanism; Advance implies a shorter tenor in common usage only.
  type               String
  principal          Float
  monthlyInstallment Float   @map("monthly_installment")
  outstandingBalance Float   @map("outstanding_balance")
  reason             String?

  /// Requested | Approved | Rejected | Active | Closed
  status String @default("Requested")

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("loan_advances")
}

/// Wave 2 W2·E09 deepening gap-closure — collapses "incentives and bonus" and
/// "variable pay" (both L2, no dedicated deep-spec) into one type-tagged
/// table, the same discipline used elsewhere in this build (IdentityDocument,
/// OrgUnit). Admin-granted, not employee-requested — created directly in
/// Approved status (audited, one step, same shape as LeaveLedgerService's
/// manual-adjustment posting) and immediately creates an ArrearEntry
/// (sourceType "IncentiveBonus") so the payout rides the existing
/// lump-sum-claimed-by-next-payroll-run mechanism from E09's own arrears
/// work — zero new payroll-engine code.
model IncentiveBonus {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Bonus | Incentive | VariablePay
  payType String @map("pay_type")
  amount  Float
  reason  String

  postedByUserId String @map("posted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("incentive_bonuses")
}

/// Wave 4 W4·E24 Document Management, docs/03-module-specifications/24-document-management.md.
/// Templates and generation already exist (DocumentTemplate/GeneratedDocument,
/// Foundation & Platform E00) — this fills the remaining real gap: a durable,
/// versioned document repository with retention. State machine collapsed 6→4:
/// Signed drops entirely (no e-signature vendor in this environment, so
/// signature_request stays deferred too) and Generated+Shared merge into
/// Published — there's no separate "share" mechanism distinct from making a
/// document visible to its owner/org scope. OCR (ocr_result) stays deferred
/// for the same no-vendor reason. Admin-managed end to end (org_admin/hr_ops
/// stand in for the spec's "Document Controller" role, same collapse used
/// throughout this build) — employee-uploaded personal documents are already
/// covered by People Management's EmployeeDocument/IdentityDocument, so this
/// repository is deliberately the HR-controlled org/employee document store,
/// not a duplicate self-upload path.
model Document {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Null = organization-wide document (e.g. a policy), not owned by one employee.
  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title String

  /// Policy | Contract | Certificate | Form | Report | Other
  category String @default("Other")

  /// Draft | Published | Archived | Expired
  status String @default("Draft")

  retentionPolicyId String?          @map("retention_policy_id") @db.Uuid
  retentionPolicy   RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id], onDelete: SetNull)

  createdByUserId String @map("created_by_user_id") @db.Uuid

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  expiredAt   DateTime? @map("expired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  versions DocumentVersion[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("documents")
}

model DocumentVersion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int        @map("version_number")
  fileId        String     @map("file_id") @db.Uuid
  file          StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  uploadedByUserId String  @map("uploaded_by_user_id") @db.Uuid
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([documentId, versionNumber])
  @@index([tenantId])
  @@index([tenantId, documentId])
  @@map("document_versions")
}

model RetentionPolicy {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String

  /// Matches Document.category, or "All"
  category        String @default("All")
  retentionMonths Int    @map("retention_months")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  documents Document[]

  @@index([tenantId])
  @@map("retention_policies")
}

/// Wave 3 W3·E11 Performance Management deepening — OKRs and Key Results.
/// Reuses the existing Goal model directly as the "Objective" rather than a
/// parallel entity; a KeyResult is a measurable sub-metric under a Goal.
/// When a Goal has one or more KeyResults its progress is computed as the
/// average completion across them (see GoalService), a real behavior
/// change rather than a manually-set percentage — the same collapse
/// discipline used throughout this build.
model KeyResult {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  goalId String @map("goal_id") @db.Uuid
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  title        String
  targetValue  Float   @map("target_value")
  currentValue Float   @default(0) @map("current_value")
  unit         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, goalId])
  @@map("key_results")
}

/// Wave 3 W3·E11 Performance Management deepening — Competency framework.
/// Admin-managed catalog; one rating per employee per competency per
/// period, rated by the employee's manager or org_admin/hr_ops — distinct
/// from the already-built 360 Feedback's multi-rater mechanism, this is a
/// single-rater skill assessment against a fixed organizational list.
model Competency {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  assessments CompetencyAssessment[]

  @@index([tenantId])
  @@map("competencies")
}

model CompetencyAssessment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  competencyId String     @map("competency_id") @db.Uuid
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  periodYear Int     @map("period_year")
  rating     Int
  comments   String?

  assessedByUserId String @map("assessed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId, competencyId, periodYear])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("competency_assessments")
}

/// Wave 3 W3·E11 Performance Management deepening — Check-ins / 1:1s. The
/// catalog's separate "check-ins" and "1:1 meetings" items collapse into
/// one entity — a check-in IS a 1:1 in this build, no distinct mechanism
/// separates them. Manager schedules for a direct report; both sides can
/// add their own notes before it's marked complete.
model CheckIn {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("CheckInEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  managerId  String   @map("manager_id") @db.Uuid
  manager    Employee @relation("CheckInManager", fields: [managerId], references: [id], onDelete: Cascade)

  scheduledDate DateTime @map("scheduled_date") @db.Date
  agenda        String?
  managerNotes  String?  @map("manager_notes")
  employeeNotes String?  @map("employee_notes")

  /// Scheduled | Completed | Cancelled
  status String @default("Scheduled")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, managerId])
  @@map("check_ins")
}

/// W5·E25 Analytics and BI — the saved-report side of the custom-report
/// builder (docs/08-submodule-specifications/25-analytics-and-bi/04-custom-reports.md).
/// Collapses custom_report_definition/custom_report_field_selection into one
/// row (selectedFields as a string array, not a child table) and drops
/// custom_report_schedule/custom_report_run_log/custom_report_share — no
/// scheduled distribution or sharing mechanism exists yet, and a run log adds
/// no value when every run is synchronous and live. filters is equality-only
/// (field -> scalar value), a documented simplification consistent with the
/// rest of this build's read-side query engines.
model ReportDefinition {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name           String
  /// Employee | LeaveRequest | PayrollRunResult
  entityType     String   @map("entity_type")
  selectedFields String[] @map("selected_fields")
  filters        Json?

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("report_definitions")
}

/// W0·E30 DevOps and Operations — feature toggles. A real boolean flag store
/// with an isEnabled() helper any service can call, not a rollout-percentage/
/// A-B-test framework (no current consumer needs staged rollout — the
/// System Settings key/value store already covers arbitrary tenant config,
/// this is deliberately narrower: on/off switches with a stable key).
model FeatureFlag {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  enabled     Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("feature_flags")
}

/// W0·E29 Security and Governance — consent management. One record per
/// (employee, purpose); status flips between Granted/Revoked rather than
/// accumulating history rows, since no consumer needs a full consent-change
/// timeline yet — just the current state.
model ConsentRecord {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// BackgroundVerification | DataSharingThirdParty | MarketingCommunications | Photography | Other
  purpose String

  /// Granted | Revoked
  status String @default("Granted")

  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, employeeId, purpose])
  @@map("consent_records")
}

/// Wave 4 W4·E15 Employee Experience gap closure ("rewards") — a redemption
/// catalog behind Recognition's existing points counter, closing the loop
/// Recognition's own comment flagged as deferred ("no redemption catalog").
/// Points balance is always computed live (sum of Recognition.points
/// received), never stored — same live-computation discipline used
/// throughout this build.
model RewardCatalogItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  description String?
  pointsCost  Int     @map("points_cost")
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  redemptions RewardRedemption[]

  @@index([tenantId])
  @@map("reward_catalog_items")
}

model RewardRedemption {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid
  rewardItemId String @map("reward_item_id") @db.Uuid

  pointsSpent Int @map("points_spent")

  /// Requested | Fulfilled | Cancelled
  status String @default("Requested")

  decisionNote String?   @map("decision_note")
  fulfilledAt  DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rewardItem RewardCatalogItem @relation(fields: [rewardItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("reward_redemptions")
}

/// Wave 4 W4·E15 gap closure ("communities") — join-based interest groups. A
/// community can optionally host its own scoped feed via FeedPost.communityId.
model Community {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  description String?
  category    String  @default("General")

  /// Active | Archived
  status String @default("Active")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  memberships CommunityMembership[]
  posts       FeedPost[]

  @@index([tenantId])
  @@map("communities")
}

model CommunityMembership {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, communityId, employeeId])
  @@index([tenantId])
  @@map("community_memberships")
}

/// Wave 4 W4·E15 gap closure ("social feed") — text-only company/community
/// feed. No photo/image uploads: avoids the moderation/consent infrastructure
/// this build deliberately doesn't have (see the deferred AI celebration-card
/// generation elsewhere in this spec). communityId null = company-wide post.
model FeedPost {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  communityId String? @map("community_id") @db.Uuid
  body        String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  employee  Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  community Community?    @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comments  FeedComment[]
  likes     FeedLike[]

  @@index([tenantId, createdAt])
  @@index([tenantId, communityId])
  @@map("feed_posts")
}

model FeedComment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  postId     String @map("post_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  body       String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  post     FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, postId])
  @@map("feed_comments")
}

model FeedLike {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  post     FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, postId, employeeId])
  @@index([tenantId, postId])
  @@map("feed_likes")
}

/// Wave 4 W4·E15 gap closure ("events") — company/team events with RSVP.
model ExperienceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  description String?
  location    String?
  startAt     DateTime @map("start_at") @db.Timestamptz(6)

  /// Draft | Published | Cancelled
  status String @default("Draft")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  rsvps  EventRsvp[]

  @@index([tenantId, startAt])
  @@map("experience_events")
}

model EventRsvp {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Going | Interested | Declined
  response String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  event    ExperienceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, eventId, employeeId])
  @@index([tenantId, eventId])
  @@map("event_rsvps")
}

/// Wave 4 W4·E15 gap closure ("employee communications") — a real two-way
/// engagement layer on top of E23's existing Announcement broadcast entity,
/// rather than a duplicate broadcast mechanism. Quote/culture libraries and
/// AI-generated milestone cards stay deferred per Announcement's own scope
/// (no moderation/photo-consent/vendor infra in this build).
model AnnouncementComment {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  announcementId String @map("announcement_id") @db.Uuid
  employeeId     String @map("employee_id") @db.Uuid
  body           String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, announcementId])
  @@map("announcement_comments")
}

/// Wave 4 W4·E15 gap closure ("wellness programs") — catalog + enrollment,
/// mirroring LearningCourse/LearningEnrollment's exact shape.
model WellnessProgram {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  title       String
  description String?

  /// Fitness | MentalHealth | Nutrition | Other
  category String @default("Other")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  /// Active | Closed
  status String @default("Active")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  enrollments WellnessEnrollment[]

  @@index([tenantId])
  @@map("wellness_programs")
}

model WellnessEnrollment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  program  WellnessProgram @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, programId, employeeId])
  @@index([tenantId, programId])
  @@map("wellness_enrollments")
}
