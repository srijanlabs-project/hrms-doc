/// Tenant-plane table (RLS enforced): first entity of the Org service.
model LegalEntity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  country  String @default("IN")
  status   String @default("active")

  /// Wave 1 deepening pass (docs/08-.../01-organization-management/01-company.md): optional link to the owning Company.
  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entities")
}

/// Wave 1 deepening pass of docs/08-submodule-specifications/01-organization-management/01-company.md.
/// Collapses company_profile/company_status_history/company_dependency_snapshot
/// into direct fields and a simple Active/Inactive status (no Draft/Retiring
/// state machine, no dependency-snapshot-before-retire check). Branding
/// (company_branding entity) and fiscal calendar are collapsed to flat fields
/// rather than separate versioned entities. Holding/group company is this
/// model's own self-relation, not a distinct concept.
model Company {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   String @default("Active")

  parentCompanyId String?   @map("parent_company_id") @db.Uuid
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subsidiaries    Company[] @relation("CompanyHierarchy")

  /// Organization branding (L1) — collapsed to flat fields, no versioned asset history.
  logoUrl      String? @map("logo_url")
  primaryColor String? @map("primary_color")
  tagline      String?

  /// Fiscal calendar (L2) — collapsed to a single start-month field (e.g. 4 = April), not a full fiscal-period ledger.
  fiscalYearStartMonth Int @default(4) @map("fiscal_year_start_month")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  legalEntities LegalEntity[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

/// Org service, second sub-module. Spec: docs/08-submodule-specifications/01-organization-management/03-department.md
/// Phase 2 slice: code, name, single-level-or-deeper parent hierarchy, and a
/// simplified Active/Inactive status. The full spec's Draft/Restructuring/
/// Retired states, ownership assignments, and merge/split workflows are
/// deferred to a later organization-management pass.
model Department {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   String @default("Active")

  parentDepartmentId String?      @map("parent_department_id") @db.Uuid
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childDepartments   Department[] @relation("DepartmentHierarchy")

  /// Wave 1 deepening pass: optional links into the broader org structure.
  orgUnitId         String?          @map("org_unit_id") @db.Uuid
  orgUnit           OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  financialCenterId String?          @map("financial_center_id") @db.Uuid
  financialCenter   FinancialCenter? @relation(fields: [financialCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  employees                 Employee[]
  requisitions              Requisition[]
  positions                 Position[]
  criticalRoles             CriticalRole[]
  externalWorkers           ExternalWorker[]
  transferPromotionRequests TransferPromotionRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// Wave 1 deepening pass, consolidating 8 catalog sub-capabilities
/// (business unit, division, section and team, branch and office, region,
/// zone, territory, campus/building/floor/work area, and location) into one
/// type-tagged hierarchy table — the org-tree spec itself treats these as
/// generic `org_node_type` values in a shared tree, not distinct entities, so
/// this collapses that generic engine (with its snapshot/reorg-event
/// machinery) into a flat self-relational table with a `unitType` tag,
/// mirroring the same category-field pattern used for ExpenseClaim/Asset.
model OrgUnit {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// BusinessUnit | Division | SectionTeam | BranchOffice | Region | Zone | Territory | Campus | Building | Floor | WorkArea | Location
  unitType String @map("unit_type")
  code     String
  name     String
  status   String @default("Active")

  parentUnitId String?   @map("parent_unit_id") @db.Uuid
  parentUnit   OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childUnits   OrgUnit[] @relation("OrgUnitHierarchy")

  /// Populated when unitType is a physical/geographic node (Location, Branch, Campus, Region, etc.) — deepens the previously-partial country/state/district/city/location coverage.
  addressLine String? @map("address_line")
  city        String?
  state       String?
  country     String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, unitType])
  @@map("org_units")
}

/// Wave 1 deepening pass, consolidating 3 catalog sub-capabilities (cost
/// center hierarchy, profit center hierarchy, project hierarchy) into one
/// type-tagged hierarchy table, same collapse rationale as OrgUnit. No
/// allocation percentages, ERP mapping, or status-history — just the
/// hierarchy and its assignment to departments/employees for costing
/// traceability.
model FinancialCenter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// CostCenter | ProfitCenter | Project
  centerType String @map("center_type")
  code       String
  name       String
  status     String @default("Active")

  parentCenterId String?           @map("parent_center_id") @db.Uuid
  parentCenter   FinancialCenter?  @relation("FinancialCenterHierarchy", fields: [parentCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childCenters   FinancialCenter[] @relation("FinancialCenterHierarchy")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  departments Department[]
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, centerType])
  @@map("financial_centers")
}

/// People Core service. Spec: docs/08-submodule-specifications/02-people-management/01-employee-master.md
/// Phase 2 "proving slice": the master record, org assignment, and the
/// documented lifecycle state enum. Deliberately deferred to later phases:
/// effective-dated assignment history (employee_assignment), duplicate
/// detection, rehire linkage, concurrent-employment policy, and sensitive
/// field masking/reveal workflows — all called out explicitly in the spec's
/// section 19 edge cases and section 3 detailed rules.
model Employee {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  employeeCode String @map("employee_code")

  legalName     String    @map("legal_name")
  preferredName String?   @map("preferred_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  personalEmail String?   @map("personal_email")
  mobileNumber  String?   @map("mobile_number")

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  managerId String?    @map("manager_id") @db.Uuid
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reports   Employee[] @relation("EmployeeManager")

  /// Wave 1 deepening pass: workforce-architecture assignment. Employment
  /// category and worker type collapses to a plain field (no classification
  /// rules/conversion-event history); position/grade/financial-center are
  /// direct FKs settable at creation or via a dedicated org-assignment
  /// endpoint — no promotion/transfer workflow or effective-dated history
  /// yet (that stays deferred to a future People Management pass).
  /// Permanent | FixedTerm | Contractor | Intern | Consultant
  workerType String @default("Permanent") @map("worker_type")

  positionId String?   @map("position_id") @db.Uuid
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  gradeId String? @map("grade_id") @db.Uuid
  grade   Grade?  @relation(fields: [gradeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  financialCenterId String?          @map("financial_center_id") @db.Uuid
  financialCenter   FinancialCenter? @relation(fields: [financialCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  designationId String?      @map("designation_id") @db.Uuid
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Wave 1 People Management deepening pass. Contract renewal (L2, no
  /// dedicated spec beyond the catalog entry) is a plain end-date field plus
  /// a ContractRenewal log, not a full contract-lifecycle document. Alumni
  /// (L1, overview-only in the spec) is two opt-in fields, not an alumni
  /// portal/directory — there is no deeper alumni spec to build against.
  /// Retirement (L2) deliberately has no new model: it reuses the existing
  /// Exit mechanism below (a Separated status with exitReason = "Retirement"),
  /// since the spec doesn't call for mechanics beyond separation-with-a-reason.
  contractEndDate    DateTime? @map("contract_end_date") @db.Date
  alumniOptIn        Boolean   @default(false) @map("alumni_opt_in")
  alumniContactEmail String?   @map("alumni_contact_email")

  /// Spec section 15 state machine: Draft, Pre-Active, Active, Suspended, Separated, Archived.
  status      String    @default("Draft")
  joiningDate DateTime? @map("joining_date") @db.Date

  /// Phase 7 addendum, v1 slice of docs/08-submodule-specifications/02-people-management/13-exit.md:
  /// set together when an admin transitions an employee to Separated. No exit
  /// interview, clearance checklist, asset-return linkage, or F&F-settlement
  /// automation yet — those stay deferred. This is just enough to (a) record
  /// when/why someone left and (b) let their still-active User account see a
  /// restricted post-exit view instead of full login (see ExitStatusGuard).
  lastWorkingDay DateTime? @map("last_working_day") @db.Date
  exitReason     String?   @map("exit_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  User[]

  leaveRequests                LeaveRequest[]               @relation("LeaveRequestEmployee")
  approvedLeaveRequests        LeaveRequest[]               @relation("LeaveRequestApprover")
  attendanceDays               AttendanceDay[]
  compensation                 EmployeeCompensation?
  payrollRunResults            PayrollRunResult[]
  requisitionsAsHiringManager  Requisition[]                @relation("RequisitionHiringManager")
  convertedFromOffer           Offer?                       @relation("OfferConvertedEmployee")
  referredCandidates           Candidate[]                  @relation("CandidateReferrer")
  internalMobilityCandidacies  Candidate[]                  @relation("InternalMobilityCandidate")
  interviewRoundsAsInterviewer InterviewRound[]             @relation("InterviewRoundInterviewer")
  feedbackCampaignsAsSubject   FeedbackCampaign[]           @relation("FeedbackCampaignSubject")
  feedbackAsRater              FeedbackRater[]              @relation("FeedbackRaterEmployee")
  calibrationCases             CalibrationCase[]            @relation("CalibrationCaseEmployee")
  certificationRecords         CertificationRecord[]
  criticalRolesAsIncumbent     CriticalRole[]               @relation("CriticalRoleIncumbent")
  successionSuccessorFor       SuccessionSuccessor[]        @relation("SuccessionSuccessorEmployee")
  benefitEnrollments           BenefitEnrollment[]
  surveyResponses              SurveyResponse[]
  recognitionsGiven            Recognition[]                @relation("RecognitionFromEmployee")
  recognitionsReceived         Recognition[]                @relation("RecognitionToEmployee")
  ticketsRaised                Ticket[]                     @relation("TicketRaiser")
  ticketsAssigned              Ticket[]                     @relation("TicketAgent")
  transferPromotionRequests    TransferPromotionRequest[]   @relation("TransferPromotionRequestEmployee")
  performanceImprovementPlans  PerformanceImprovementPlan[]
  learningPathEnrollments      LearningPathEnrollment[]
  careerPlans                  CareerPlan[]
  onboardingCase               OnboardingCase?
  goals                        Goal[]
  appraisals                   Appraisal[]
  competencyAssessments        CompetencyAssessment[]
  checkInsAsEmployee           CheckIn[]                    @relation("CheckInEmployee")
  checkInsAsManager            CheckIn[]                    @relation("CheckInManager")
  learningEnrollments          LearningEnrollment[]
  talentAssessments            TalentAssessment[]
  compensationReviewItems      CompensationReviewItem[]
  payoutPlanItems              PayoutPlanItem[]
  esopGrants                   EsopGrant[]
  expenseClaims                ExpenseClaim[]               @relation("ExpenseClaimEmployee")
  approvedExpenseClaims        ExpenseClaim[]               @relation("ExpenseClaimApprover")
  travelRequests               TravelRequest[]              @relation("TravelRequestEmployee")
  approvedTravelRequests       TravelRequest[]              @relation("TravelRequestApprover")
  assetAssignments             AssetAssignment[]
  reportingLines               ReportingLine[]              @relation("ReportingLineEmployee")
  managedReportingLines        ReportingLine[]              @relation("ReportingLineManager")
  personalDetail               PersonalDetail?
  emergencyContacts            EmergencyContact[]
  identityDocuments            IdentityDocument[]
  bankAccounts                 BankAccount[]
  taxProfile                   TaxProfile?
  documents                    EmployeeDocument[]
  certifications               EmployeeCertification[]
  skills                       EmployeeSkill[]
  educationRecords             EducationRecord[]
  priorExperience              PriorExperience[]
  assignmentHistory            EmployeeAssignmentHistory[]  @relation("AssignmentHistoryEmployee")
  probationRecords             ProbationRecord[]
  salaryRevisions              SalaryRevision[]
  contractRenewals             ContractRenewal[]
  generatedDocuments           GeneratedDocument[]
  shiftAssignments             ShiftAssignment[]
  rosterEntries                RosterEntry[]
  timesheetEntries             TimesheetEntry[]
  overtimeRequests             OvertimeRequest[]
  leaveLedgerEntries           LeaveLedgerEntry[]
  employeePayComponents        EmployeePayComponent[]
  arrearEntries                ArrearEntry[]
  fnfCase                      FnfCase?
  flexAssignments              EmployeeFlexAssignment[]
  rotationAssignments          EmployeeRotationAssignment[]
  leaveEncashmentRequests      LeaveEncashmentRequest[]
  loanAdvances                 LoanAdvance[]
  incentiveBonuses             IncentiveBonus[]
  hostedVisitors               Visitor[]
  workplaceBookings            WorkplaceBooking[]
  reportedSafetyIncidents      SafetyIncident[]
  conductedSafetyAssessments   SafetyAssessment[]
  healthRecords                HealthRecord[]
  documentRecords              Document[]
  consentRecords               ConsentRecord[]
  rewardRedemptions            RewardRedemption[]
  communityMemberships         CommunityMembership[]
  feedPosts                    FeedPost[]
  feedComments                 FeedComment[]
  feedLikes                    FeedLike[]
  eventRsvps                   EventRsvp[]
  announcementComments         AnnouncementComment[]
  wellnessEnrollments          WellnessEnrollment[]
  travelAdvances               TravelAdvance[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("employees")
}

/// Identity & Access, "RBAC v1" slice per docs/03-module-specifications/03-identity-access.md
/// and 08-.../03-identity-and-access/01-authentication.md. Deliberately
/// deferred: the full role/permission governance catalog (versioning,
/// publish/retire, SoD, certification — 04-roles.md, 05-permissions.md),
/// SSO/federation and full MFA enrollment (02-sso.md, 03-mfa.md —
/// Keycloak/OIDC per the tech-stack ADR, blocked on Docker availability),
/// delegation, service accounts, and lockout/step-up-auth policy. `roles`
/// is a plain string array standing in for the governed role catalog until
/// that pass exists. Login is OTP-only (see OtpChallenge below); passwordHash
/// stays nullable for a possible future password/service-account path.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String?  @map("password_hash")
  roles        String[] @default([])

  /// Spec section 14 state machine: Invited, Active, Locked, Suspended, Deprovisioned.
  status String @default("Active")

  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  sessions            Session[]
  otpChallenges       OtpChallenge[]
  notifications       Notification[]
  mfaFactors          MfaFactor[]
  delegationsGiven    Delegation[]       @relation("DelegationDelegator")
  delegationsReceived Delegation[]       @relation("DelegationDelegate")
  auditLogsAsActor    AuditLog[]         @relation("AuditActor")
  accessReviewItems   AccessReviewItem[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Backs real session revocation (auth.session_revoked event, spec section 6)
/// rather than purely stateless JWTs — the JWT carries this row's id (`sid`)
/// and AuthGuard checks it hasn't been revoked or expired on every request.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

/// One-time-passcode login challenge. Shape follows the `mfa_challenge`
/// entity in 08-.../03-identity-and-access/03-mfa.md §6 (issued/expiry/
/// verification-status/attempt-count), reused here as the PRIMARY login
/// factor rather than a second factor on top of a password — an approved
/// pattern per 01-authentication.md §3 ("magic-link... enterprise
/// authentication pattern"). `codeHash` is bcrypt-hashed even in dev, so the
/// verify path never has to change when StaticDevOtpProvider is swapped for
/// a real SMS/email gateway (see auth/otp/otp-provider.ts).
model OtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @map("code_hash")
  /// email | sms, per the MFA spec's channel list. Only email is wired up.
  channel      String    @default("email")
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("otp_challenges")
}

/// Leave module, Phase 4 slice. Spec: docs/08-submodule-specifications/08-leave-management/01-leave-policies.md
/// Deliberately a fixed leave-type + flat annual entitlement, not the full
/// applicability-matrix/versioning/publish/simulation model the spec
/// describes — that governance layer is a later leave-management pass.
model LeavePolicy {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  /// Annual | Casual | Sick for this slice; spec section 3 lists many more types.
  leaveType  String @map("leave_type")
  name       String
  annualDays Float  @map("annual_days")
  status     String @default("Active")

  /// Wave 2 W2·E08 deepening (02-leave-accrual.md). Max days LeaveLedgerService.runCarryForward
  /// may carry from one year into the next for this leave type. 0 (default) means no
  /// carry-forward — existing seeded policies keep today's behavior unless explicitly raised.
  carryForwardCapDays Float @default(0) @map("carry_forward_cap_days")

  /// Wave 2 W2·E08 gap-closure. false (default): a leave request's day count
  /// excludes non-working days (per the effective WorkCalendar) that fall
  /// inside its range. true: the full inclusive calendar-day count is charged
  /// instead — a weekend/holiday "sandwiched" between two leave-consuming
  /// days counts against the employee too.
  sandwichRuleEnabled Boolean @default(false) @map("sandwich_rule_enabled")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant                   @relation(fields: [tenantId], references: [id])
  ledgerEntries      LeaveLedgerEntry[]
  encashmentRequests LeaveEncashmentRequest[]

  @@unique([tenantId, leaveType])
  @@index([tenantId])
  @@map("leave_policies")
}

/// Spec: docs/08-submodule-specifications/08-leave-management/03-leave-approval.md
/// Phase 4 slice: single-level approval (requestor's direct manager only),
/// simplified state machine (Pending/Approved/Rejected/Cancelled — the
/// spec's Draft/Submitted/Sent-Back/Partially-Cancelled states are
/// deferred), and no delegation/escalation/team-overlap visibility.
/// Balance is NOT a stored ledger here — LeaveBalanceService computes it
/// live from Employee.joiningDate + this table's Approved rows, deferring
/// the persisted-ledger + BullMQ-accrual-job model in 02-leave-accrual.md
/// (no queue infrastructure exists yet — see tech-stack ADR).
model LeaveRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  leaveType String   @map("leave_type")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  /// Inclusive calendar-day count computed at submission. Half-days,
  /// weekend/holiday exclusion, and sandwich rules are deferred.
  days      Float
  reason    String?

  /// Pending, Approved, Rejected, Cancelled.
  status String @default("Pending")

  approverId String?   @map("approver_id") @db.Uuid
  approver   Employee? @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, approverId])
  @@map("leave_requests")
}

/// In-app notification inbox, Phase 4 slice. Only leave-request lifecycle
/// events publish here for now; the full notification-catalog/channel model
/// (appendix 3, 16) is deferred.
model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  type     String
  title    String
  body     String
  linkPath String? @map("link_path")

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("notifications")
}

/// Workforce Management, Phase 5 slice. Spec: docs/08-submodule-specifications/07-workforce-management/01-attendance.md
/// Deliberately manual-only: no biometric/device capture sources, no shift
/// mapping, no regularization workflow, no cross-midnight handling — a
/// single self-marked status per calendar day. The spec's six-entity model
/// (attendance_event, attendance_day_record, attendance_exception,
/// attendance_regularization, attendance_policy_rule,
/// attendance_finalization_batch) is collapsed to this one table for v1.
model AttendanceDay {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  /// Present | Absent | HalfDay
  status     String
  source     String   @default("Manual")

  /// Wave 2 W2·E07 deepening gap-closure (flexible hours). Self-reported "HH:mm"
  /// — no punch-clock capture exists in this build — evaluated against the
  /// employee's active FlexibleHoursPolicy assignment, if any, when both are present.
  checkInTime   String?  @map("check_in_time")
  checkOutTime  String?  @map("check_out_time")
  flexCompliant Boolean? @map("flex_compliant")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("attendance_days")
}

/// Payroll, Phase 5 slice. Spec: docs/08-submodule-specifications/09-payroll/01-salary-structures.md
/// and 02-pay-components.md. Deliberately NOT the full versioned/composable
/// structure + component-catalog model those specs describe (no publish
/// workflow, no formula engine, no applicability matrix) — one active flat
/// compensation record per employee, with HRA/special-allowance/PF/ESIC/PT/TDS
/// all derived by fixed formula in PayrollCalculationService rather than
/// configurable components. See that service for the exact rules and every
/// simplification made against real Indian statutory law.
model EmployeeCompensation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  monthlyBasic  Float    @map("monthly_basic")
  effectiveFrom DateTime @map("effective_from") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@map("employee_compensations")
}

/// Spec: docs/08-submodule-specifications/09-payroll/05-payroll-processing.md
/// Collapses the spec's 9-state model (Created/Inputs Ready/Processing/
/// Processed with Exceptions/Processed/Approval Pending/Approved/Close
/// Ready/Closed) to 4: Draft, Processed, Approved, Closed. Off-cycle runs,
/// employee-level rerun, and a separate payroll_recalculation_event audit
/// trail are deferred — reprocessing overwrites PayrollRunResult rows
/// in place while status is Draft/Processed (blocked once Approved).
model PayrollRun {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  periodYear  Int    @map("period_year")
  periodMonth Int    @map("period_month")

  /// Draft | Processed | Approved | Closed
  status String @default("Draft")

  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  results       PayrollRunResult[]
  arrearEntries ArrearEntry[]

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId])
  @@map("payroll_runs")
}

/// One row per employee per run: the frozen input snapshot (payableDays /
/// totalWorkingDays) plus every calculated output. Collapses the spec's
/// payroll_input_snapshot + payroll_component_result + payroll_exception
/// into a single table for v1 — see PayrollRun's comment for the rest of
/// the collapsing rationale. Amount fields are nullable because a blocking
/// exception (e.g. no EmployeeCompensation configured) leaves them unset.
model PayrollRunResult {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  payrollRunId String @map("payroll_run_id") @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid

  payableDays      Float @map("payable_days")
  totalWorkingDays Float @map("total_working_days")

  basic            Float? @map("basic")
  hra              Float? @map("hra")
  /// Wave 2 W2·E09 deepening: sum of the employee's active EmployeePayComponent
  /// earnings for this period (was always 0 pre-deepening — see payroll-calculator.ts).
  specialAllowance Float? @map("special_allowance")
  grossEarnings    Float? @map("gross_earnings")
  pfEmployee       Float? @map("pf_employee")
  pfEmployer       Float? @map("pf_employer")
  esicEmployee     Float? @map("esic_employee")
  esicEmployer     Float? @map("esic_employer")
  professionalTax  Float? @map("professional_tax")
  tds              Float? @map("tds")
  /// Sum of the employee's active EmployeePayComponent deductions for this period.
  otherDeductions  Float? @map("other_deductions")
  /// Lump sum from any Pending ArrearEntry rows consumed into this run (04-arrears-and-retro-pay.md).
  arrearsIncluded  Float? @map("arrears_included")
  netPay           Float? @map("net_pay")

  hasException  Boolean @default(false) @map("has_exception")
  exceptionNote String? @map("exception_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("payroll_run_results")
}

/// Phase 6 slice. Spec: docs/08-submodule-specifications/06-recruitment-and-ats/02-requisitions.md.
/// Collapses the spec's 8-state model (Draft/Submitted/Approved/Published/
/// OnHold/Closed/Cancelled/Reopened) to 6 — Submitted is folded into Draft
/// (single-level approval, no separate submit step) and Reopened is folded
/// into re-publishing a Closed/OnHold requisition. No amendment history,
/// posting-channel rules, or confidentiality classes — see requisition
/// service comments for the full deferral list.
model Requisition {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String

  title        String
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  hiringManagerId String?   @map("hiring_manager_id") @db.Uuid
  hiringManager   Employee? @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  headcount       Int       @default(1)
  compensationMin Float?    @map("compensation_min")
  compensationMax Float?    @map("compensation_max")
  targetJoinDate  DateTime? @map("target_join_date") @db.Date

  /// Internal Mobility: when true, this opening is visible on the internal
  /// jobs board and current employees may self-apply, alongside (not
  /// instead of) the normal external pipeline once Published.
  isInternal Boolean @default(false) @map("is_internal")

  /// Draft | Approved | Published | OnHold | Closed | Cancelled
  status String @default("Draft")

  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  applications Application[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("requisitions")
}

/// Phase 6 slice, deepened in the Wave 2 E06 pass. No candidate portal or
/// resume storage — a candidate is contact info + a source tag. Screening
/// stays collapsed into Application.stage (no resume-parsing infra exists to
/// justify a real screening entity); interview scheduling and feedback are
/// now real (see InterviewRound/InterviewFeedback below). `referredByEmployeeId`
/// backs the Employee Referrals sub-capability — a real catalog gap, not
/// covered by any deep-spec file.
model Candidate {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  fullName String @map("full_name")
  email    String

  /// Direct | Referral | JobBoard | Internal
  source String @default("Direct")

  referredByEmployeeId String?   @map("referred_by_employee_id") @db.Uuid
  referredByEmployee   Employee? @relation("CandidateReferrer", fields: [referredByEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Set when source is "Internal" — the existing employee applying to an internal-mobility requisition.
  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation("InternalMobilityCandidate", fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Talent Pool (W3·E06 gap closure): a candidate with zero applications is,
  /// by definition, a pool/sourced candidate — no separate pool entity.
  /// tags/notes exist to make that pool searchable.
  tags  String[] @default([])
  notes String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  applications Application[]
  assessments  CandidateAssessment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

/// One candidate applying to one requisition. `stage` still collapses
/// screening into a single pipeline field, but interview scheduling and
/// feedback now hang off InterviewRound rows keyed to this application.
model Application {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  requisitionId String @map("requisition_id") @db.Uuid
  candidateId   String @map("candidate_id") @db.Uuid

  /// Applied | Screening | Interview | Offer | Hired | Rejected
  stage           String  @default("Applied")
  rejectionReason String? @map("rejection_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  requisition     Requisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidate       Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  offer           Offer?
  interviewRounds InterviewRound[]
  assessments     CandidateAssessment[]

  @@unique([requisitionId, candidateId])
  @@index([tenantId])
  @@index([tenantId, requisitionId])
  @@map("applications")
}

/// Pre-hire candidate assessments (W3·E06 gap closure) — a distinct concept
/// from employee-facing performance/competency assessments (E11/E13):
/// administered during the recruitment pipeline, before conversion.
model CandidateAssessment {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  candidateId   String       @map("candidate_id") @db.Uuid
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applicationId String?      @map("application_id") @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Technical | Aptitude | Behavioral | Other
  type     String
  score    Float?
  maxScore Float?  @map("max_score")
  notes    String?

  administeredAt       DateTime @default(now()) @map("administered_at") @db.Timestamptz(6)
  administeredByUserId String?  @map("administered_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, candidateId])
  @@map("candidate_assessments")
}

/// v1 slice of 06-interview-scheduling.md: collapses interview_plan/
/// interview_slot/interview_panel_member/candidate_availability/
/// calendar_sync_log into one row per round — a single interviewer, no
/// panel, no calendar-sync log (no real calendar provider in this
/// environment). One round per (application, roundNumber).
model InterviewRound {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  roundNumber   Int    @map("round_number")

  interviewerId String   @map("interviewer_id") @db.Uuid
  scheduledAt   DateTime @map("scheduled_at") @db.Timestamptz(6)

  /// InPerson | Video | Phone
  mode String @default("Video")

  /// Scheduled | Completed | Cancelled
  status String @default("Scheduled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  application Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  interviewer Employee           @relation("InterviewRoundInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feedback    InterviewFeedback?

  @@unique([applicationId, roundNumber])
  @@index([tenantId])
  @@map("interview_rounds")
}

/// v1 slice of 07-interview-feedback.md: collapses interview_feedback_rating/
/// interview_feedback_comment/interview_debrief/feedback_template/
/// feedback_version_log into one flat row per round — a single rating,
/// recommendation, and free-text comment, no rubric/competency breakdown or
/// blind-review flag.
model InterviewFeedback {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  interviewRoundId String @unique @map("interview_round_id") @db.Uuid

  /// 1-5
  rating Int

  /// StrongHire | Hire | NoHire | StrongNoHire
  recommendation String
  comments       String?

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  interviewRound InterviewRound @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@map("interview_feedback")
}

/// Spec: docs/08-submodule-specifications/06-recruitment-and-ats/08-offer-management.md.
/// Collapses the spec's 10-state model to 8 (negotiation and expired folded
/// out — no counter-offer workflow or expiry-timer job in v1). One flat
/// monthlyBasic like EmployeeCompensation, not the full component/clause/
/// template system. Accepting an offer converts it directly to a Draft
/// Employee + OnboardingCase (see OfferService) — no separate preboarding
/// entity.
model Offer {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  applicationId String @unique @map("application_id") @db.Uuid

  monthlyBasic Float    @map("monthly_basic")
  joiningDate  DateTime @map("joining_date") @db.Date

  /// Draft | PendingApproval | Approved | Issued | Accepted | Declined | Withdrawn | Converted
  status String @default("Draft")

  approvedByUserId String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  issuedAt         DateTime? @map("issued_at") @db.Timestamptz(6)
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(6)
  declineReason    String?   @map("decline_reason")

  convertedEmployeeId String?   @unique @map("converted_employee_id") @db.Uuid
  convertedEmployee   Employee? @relation("OfferConvertedEmployee", fields: [convertedEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  backgroundCheck BackgroundCheck?

  @@index([tenantId])
  @@map("offers")
}

/// L2 item covered inside 08-offer-management.md ("pre-joining document
/// checklist and background verification dependencies") — not a dedicated
/// deep-spec, so no separate panel/report/scoring machinery. One check per
/// offer, admin-recorded (no real third-party verification vendor in this
/// environment). A Flagged result blocks `OfferService.convert()` — see
/// OfferService — giving the check real teeth rather than being advisory.
model BackgroundCheck {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  offerId  String @unique @map("offer_id") @db.Uuid

  /// Identity | Employment | Education | Criminal | Comprehensive
  checkType String @default("Comprehensive") @map("check_type")

  /// Pending | Cleared | Flagged
  status  String  @default("Pending")
  remarks String?

  initiatedByUserId String    @map("initiated_by_user_id") @db.Uuid
  initiatedAt       DateTime  @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@map("background_checks")
}

/// Phase 6 slice. Spec: docs/08-submodule-specifications/02-people-management/09-onboarding.md.
/// Collapses the spec's 6-state case model (Created/In Progress/Ready for
/// Join Date/Blocked/Activated/Cancelled) to 5 — Created folds into
/// InProgress since a case is created with its checklist already attached.
/// One case per employee, created automatically when an Offer converts (see
/// OfferService.convert) with a fixed task checklist (ONBOARDING_TASKS in
/// onboarding.service.ts) rather than the spec's configurable
/// checklist-template-by-worker-type/geography engine.
model OnboardingCase {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @unique @map("employee_id") @db.Uuid

  /// InProgress | ReadyForActivation | Blocked | Activated | Cancelled
  status String @default("InProgress")

  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tasks    OnboardingTask[]

  @@index([tenantId])
  @@map("onboarding_cases")
}

/// Collapses the spec's 7-state task model (Not Started/In Progress/
/// Submitted/Approved/Rejected/Waived/Completed) to 3 — no document
/// upload/review sub-workflow in v1, a task is simply done or not.
model OnboardingTask {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  caseId   String @map("case_id") @db.Uuid

  title      String
  isBlocking Boolean @default(true) @map("is_blocking")

  /// NotStarted | Completed | Waived
  status      String    @default("NotStarted")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  case   OnboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, caseId])
  @@map("onboarding_tasks")
}

/// Phase 7 slice. Spec: docs/08-submodule-specifications/11-performance-management/01-goal-management.md.
/// No cascading/alignment links, no shared goals, no milestones/evidence
/// attachments, no separate check-in history entity — progress is a single
/// updatable percentage + note. Collapses the spec's 8-state model (draft/
/// submitted/returned/approved/in-progress/on-hold/completed/closed) to 4.
model Goal {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  periodYear   Int       @map("period_year")
  title        String
  description  String?
  weight       Int       @default(100)
  progress     Int       @default(0)
  progressNote String?   @map("progress_note")
  dueDate      DateTime? @map("due_date") @db.Date

  /// Draft | Active | Completed | Closed
  status String @default("Draft")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  keyResults KeyResult[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("goals")
}

/// Spec: docs/08-submodule-specifications/11-performance-management/02-appraisals.md.
/// Self + manager review only — no skip-level, no calibration, no disputes,
/// no configurable multi-section forms. One overall rating (1-5) and one
/// comments field per side. Collapses the spec's 9-state model to 4.
model Appraisal {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  periodYear Int @map("period_year")

  /// Draft | SelfSubmitted | ManagerReviewed | Finalized
  status String @default("Draft")

  selfRating      Int?      @map("self_rating")
  selfComments    String?   @map("self_comments")
  selfSubmittedAt DateTime? @map("self_submitted_at") @db.Timestamptz(6)

  managerRating      Int?      @map("manager_rating")
  managerComments    String?   @map("manager_comments")
  managerSubmittedAt DateTime? @map("manager_submitted_at") @db.Timestamptz(6)

  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(6)

  /// Wave 3 E11 deepening (04-calibration.md): set when a CalibrationSession
  /// closes and this appraisal was one of its cases. Defaults to
  /// managerRating if the committee didn't adjust it. Null means this
  /// appraisal has never been calibrated — the UI falls back to
  /// managerRating in that case.
  calibratedRating     Int?    @map("calibrated_rating")
  calibrationSessionId String? @map("calibration_session_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  calibrationSession CalibrationSession? @relation(fields: [calibrationSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  calibrationCase    CalibrationCase?

  @@unique([tenantId, employeeId, periodYear])
  @@index([tenantId])
  @@map("appraisals")
}

/// v1 slice of 03-360-feedback.md: collapses feedback_360_participant/
/// feedback_360_question/feedback_360_report into a flat structure — one
/// subject employee per campaign per cycle, a single fixed rating+two-text-field
/// questionnaire (no configurable question bank), no anonymity-threshold
/// enforcement or tokenized rater links (a small single-tenant deployment has
/// no real anonymity risk to model against), no reminder/expiry job.
model FeedbackCampaign {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  subjectEmployeeId String @map("subject_employee_id") @db.Uuid
  cycleYear         Int    @map("cycle_year")

  /// Draft | Open | Closed
  status String @default("Draft")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  subjectEmployee Employee        @relation("FeedbackCampaignSubject", fields: [subjectEmployeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  raters          FeedbackRater[]

  @@unique([tenantId, subjectEmployeeId, cycleYear])
  @@index([tenantId])
  @@map("feedback_campaigns")
}

/// One nominated rater per campaign. Self-service: the nominated employee
/// submits their own response once the campaign is Open.
model FeedbackRater {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid

  raterEmployeeId String @map("rater_employee_id") @db.Uuid

  /// Manager | Peer | DirectReport | Self
  category String @default("Peer")

  /// Invited | Completed
  status String @default("Invited")

  rating           Int?
  strengths        String?
  developmentAreas String?   @map("development_areas")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  campaign      FeedbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  raterEmployee Employee         @relation("FeedbackRaterEmployee", fields: [raterEmployeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([campaignId, raterEmployeeId])
  @@index([tenantId])
  @@map("feedback_raters")
}

/// v1 slice of 04-calibration.md: collapses calibration_cohort/
/// calibration_distribution_snapshot out — a session's "cohort" is just a
/// free-text label plus periodYear, no distribution-guidance bands or
/// snapshot history. Committee-only (org_admin/hr_ops), no separate
/// participant-role model.
model CalibrationSession {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  periodYear  Int    @map("period_year")
  cohortLabel String @map("cohort_label")

  /// Draft | InSession | Closed
  status String @default("Draft")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  cases      CalibrationCase[]
  appraisals Appraisal[]

  @@unique([tenantId, periodYear, cohortLabel])
  @@index([tenantId])
  @@map("calibration_sessions")
}

/// One Finalized appraisal pulled into a session. originalRating is a
/// snapshot of managerRating at generation time; calibratedRating stays null
/// until the committee decides (closing the session defaults any
/// undecided case to its originalRating). rationale is required whenever
/// calibratedRating differs from originalRating (enforced in the service).
model CalibrationCase {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  sessionId   String @map("session_id") @db.Uuid
  appraisalId String @unique @map("appraisal_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid

  originalRating   Int     @map("original_rating")
  calibratedRating Int?    @map("calibrated_rating")
  rationale        String?

  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  session   CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  appraisal Appraisal          @relation(fields: [appraisalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee  Employee           @relation("CalibrationCaseEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionId, appraisalId])
  @@index([tenantId])
  @@map("calibration_cases")
}

/// Phase 7 slice. Spec: docs/08-submodule-specifications/12-learning-and-development/01-learning-management-system.md.
/// A single flat course catalog — no programs/pathways/cohorts/sessions,
/// no prerequisite dependency graph, no multi-language metadata. Collapses
/// the spec's 4-state object lifecycle (Draft/Published/Archived/Superseded)
/// to 3 by dropping "Superseded" (a course is simply archived and replaced
/// with a new catalog entry).
model LearningCourse {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title         String
  description   String?
  durationHours Int     @map("duration_hours")
  isMandatory   Boolean @default(false) @map("is_mandatory")

  /// Wave 3 E12 deepening (03-compliance-training.md): only meaningful when
  /// isMandatory — null means one-time, a value (e.g. 12) means the
  /// enrollment renews on that cycle after completion. Consumed by
  /// EnrollmentService's daily assignment sweep, not a generic recurrence engine.
  recurrenceMonths Int? @map("recurrence_months")

  /// Wave 3 E12 gap closure ("assessments"): null means completion is a plain
  /// mark-complete as before; a value (0-100) requires a passing
  /// EnrollmentService.submitAssessment() score before the enrollment can
  /// become Completed.
  passingScore Int? @map("passing_score")

  /// Wave 3 E12 gap closure ("skill development"): which skills this course
  /// develops — cross-referenced against EmployeeSkill for recommendations,
  /// no new skills taxonomy.
  skillTags String[] @default([]) @map("skill_tags")

  /// Draft | Published | Archived
  status String @default("Draft")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  enrollments LearningEnrollment[]
  pathCourses LearningPathCourse[]

  @@index([tenantId])
  @@map("learning_courses")
}

/// Spec: docs/08-submodule-specifications/12-learning-and-development/01-learning-management-system.md.
/// Self-enroll and admin-assign only — no waitlists, no attendance/session
/// tracking, no assessment scoring, no external-import equivalency. Collapses
/// the spec's 7-state model (Assigned/Enrolled/In Progress/Completed/Failed/
/// Withdrawn/Expired) to 3.
model LearningEnrollment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  courseId   String @map("course_id") @db.Uuid

  /// Enrolled | Completed | Withdrawn | Overdue
  status      String    @default("Enrolled")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Wave 3 E12 deepening: set only on system-assigned mandatory enrollments
  /// (assignedAutomatically = true) — the daily sweep flips Enrolled past
  /// this date to Overdue and escalates to the employee's manager. A
  /// completed recurring enrollment is reset back to Enrolled with a new
  /// dueDate at the next cycle rather than creating a second row, since
  /// (tenantId, employeeId, courseId) stays unique — no multi-cycle history.
  dueDate               DateTime? @map("due_date") @db.Timestamptz(6)
  assignedAutomatically Boolean   @default(false) @map("assigned_automatically")

  /// Wave 3 E12 gap closure ("assessments") — only set once
  /// EnrollmentService.submitAssessment() has been called at least once.
  /// assessmentPassed=false with status still Enrolled means the employee
  /// may resubmit; the same row is reused, no attempt-history table.
  assessmentScore    Int?     @map("assessment_score")
  assessmentMaxScore Int?     @map("assessment_max_score")
  assessmentPassed   Boolean? @map("assessment_passed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course   LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, employeeId, courseId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("learning_enrollments")
}

/// Wave 3 E12 gap closure ("learning paths") — a curated, ordered sequence of
/// existing LearningCourse rows. Course-level completion stays the single
/// source of truth (LearningEnrollment); a path's progress is always computed
/// live from its courses' enrollments, never stored, so there's no
/// path-vs-course sync problem to solve.
model LearningPath {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title       String
  description String?

  /// Draft | Published | Archived
  status String @default("Draft")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  courses     LearningPathCourse[]
  enrollments LearningPathEnrollment[]

  @@index([tenantId])
  @@map("learning_paths")
}

model LearningPathCourse {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  pathId   String @map("path_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  sequenceOrder Int @map("sequence_order")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  path   LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, pathId, courseId])
  @@index([tenantId])
  @@index([tenantId, pathId])
  @@map("learning_path_courses")
}

/// A membership record only — no stored status/progress, see LearningPath's
/// doc comment.
model LearningPathEnrollment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  pathId     String @map("path_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, employeeId, pathId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("learning_path_enrollments")
}

/// v1 slice of 02-certifications.md: collapses certification_requirement/
/// certification_verification/certification_renewal_case/equivalency-mapping
/// into a flat catalog — no role-eligibility rule engine or equivalency
/// groups, since nothing in this build currently blocks staffing on a
/// missing certification.
model CertificationCatalog {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  issuer   String?

  /// null = does not expire
  validityMonths Int?    @map("validity_months")
  isMandatory    Boolean @default(false) @map("is_mandatory")
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant                @relation(fields: [tenantId], references: [id])
  records CertificationRecord[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("certification_catalog")
}

/// One record per employee per catalog entry. Starts Active immediately on
/// creation (no Draft/PendingVerification gate — verification is an
/// after-the-fact admin confirmation, not a blocker on use). The daily sweep
/// (reusing the Scheduler-engine cron pattern from ComplianceCalendarService)
/// flips Active -> Expiring within the reminder window, then -> Expired past
/// expiryDate, and notifies the employee plus admins for mandatory records.
model CertificationRecord {
  id                     String @id @default(uuid()) @db.Uuid
  tenantId               String @map("tenant_id") @db.Uuid
  employeeId             String @map("employee_id") @db.Uuid
  certificationCatalogId String @map("certification_catalog_id") @db.Uuid

  certificateNumber String?   @map("certificate_number")
  issueDate         DateTime  @map("issue_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date

  /// Active | Expiring | Expired | Revoked
  status String @default("Active")

  evidenceFileId String?     @map("evidence_file_id") @db.Uuid
  evidenceFile   StoredFile? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  revokedReason    String?   @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  certification CertificationCatalog @relation(fields: [certificationCatalogId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("certification_records")
}

/// Phase 7 slice. Spec: docs/08-submodule-specifications/13-talent-management/02-talent-reviews.md.
/// A single 9-box placement per employee per period, entered directly by
/// org_admin/hr_ops — no review cycles, no calibration sessions or change
/// history, no development/retention/mobility action tracking, no
/// confidential-note segmentation, no succession-planning links. Collapses
/// the spec's 5-state cycle model (Draft/Open/Calibrating/Finalized/Archived)
/// entirely: there is no cycle object, just a directly-editable placement.
model TalentAssessment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  periodYear Int @map("period_year")

  performanceRating Int     @map("performance_rating")
  /// Low | Medium | High
  potentialRating   String  @map("potential_rating")
  notes             String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, employeeId, periodYear])
  @@index([tenantId])
  @@map("talent_assessments")
}

/// v1 slice of 01-succession-planning.md: collapses succession_cycle/
/// succession_slate/succession_risk_indicator/succession_development_action
/// into two flat tables — a critical role stays critical until deactivated
/// (no versioned review cycle for the designation itself), and successors
/// are added/removed directly rather than through a slate/calibration
/// workflow. No risk indicators (flight/retirement risk) — no data source
/// exists in this build to compute them against. Confidential per the spec
/// (section 10): the whole module is org_admin/hr_ops only, no self-service.
model CriticalRole {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  title        String
  departmentId String? @map("department_id") @db.Uuid

  incumbentEmployeeId String? @map("incumbent_employee_id") @db.Uuid

  /// High | Medium | Low
  criticalityTier String  @default("Medium") @map("criticality_tier")
  isActive        Boolean @default(true) @map("is_active")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  department Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  incumbent  Employee?             @relation("CriticalRoleIncumbent", fields: [incumbentEmployeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  successors SuccessionSuccessor[]

  @@index([tenantId])
  @@map("critical_roles")
}

/// One successor per (role, employee). readiness collapses the spec's
/// "ready now / ready in 1 year / ready in 2 years / high-potential unknown"
/// into a fixed set; isEmergency is a separate flag rather than a distinct
/// readiness track, since an emergency successor can be at any readiness level.
model SuccessionSuccessor {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  criticalRoleId String @map("critical_role_id") @db.Uuid
  employeeId     String @map("employee_id") @db.Uuid

  /// ReadyNow | Ready1Year | Ready2Years | Unknown
  readiness   String  @default("Unknown")
  isEmergency Boolean @default(false) @map("is_emergency")
  notes       String?

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  criticalRole CriticalRole @relation(fields: [criticalRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee     Employee     @relation("SuccessionSuccessorEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([criticalRoleId, employeeId])
  @@index([tenantId])
  @@map("succession_successors")
}

/// Phase 7 slice. Spec: docs/08-submodule-specifications/14-compensation-and-benefits/03-merit-cycles.md.
/// One cycle per period year, one review item per employee — no budget
/// pools, guideline matrices, exception routing, or scenario mode. Collapses
/// the spec's 7-state cycle model (draft/configured/planning-open/submitted/
/// approved/published/closed) to 2 (Open/Closed): the item-level status
/// carries the real workflow instead. "Publish" is replaced by a direct
/// per-item Apply action that writes through to EmployeeCompensation via
/// the existing CompensationRepository — no downstream payroll export batch.
model CompensationReviewCycle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  periodYear Int @map("period_year")

  /// Open | Closed
  status String @default("Open")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant                   @relation(fields: [tenantId], references: [id])
  items  CompensationReviewItem[]

  @@unique([tenantId, periodYear])
  @@index([tenantId])
  @@map("compensation_review_cycles")
}

/// One proposed pay change per employee per cycle. currentMonthlyBasic is a
/// snapshot taken at proposal time (not live-recomputed) so the recommended
/// increase stays stable even if EmployeeCompensation changes elsewhere
/// before this item is applied.
model CompensationReviewItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  cycleId    String @map("cycle_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  currentMonthlyBasic  Float @map("current_monthly_basic")
  proposedMonthlyBasic Float @map("proposed_monthly_basic")

  /// Proposed | Approved | Applied
  status    String    @default("Proposed")
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  cycle    CompensationReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@map("compensation_review_items")
}

/// Wave 3 E14 gap closure ("bonus planning", "incentives") — one cycle model
/// covering both, mirroring CompensationReviewCycle/Item's exact Proposed ->
/// Approved -> Applied shape (renamed "Posted" here since applying means
/// posting a real payout, not writing back compensation). payType reuses
/// IncentiveBonus's own enum (Bonus | Incentive) so a posted item rides the
/// same ArrearEntry-backed payroll consumption path IncentiveBonusService
/// already provides — no parallel payout mechanism.
model PayoutPlanCycle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  periodYear Int    @map("period_year")
  label      String

  /// Bonus | Incentive
  payType String @map("pay_type")

  /// Open | Closed
  status String @default("Open")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  items  PayoutPlanItem[]

  @@unique([tenantId, periodYear, payType, label])
  @@index([tenantId])
  @@map("payout_plan_cycles")
}

model PayoutPlanItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  cycleId    String @map("cycle_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  proposedAmount Float  @map("proposed_amount")
  reason         String

  /// Proposed | Approved | Rejected | Posted
  status       String    @default("Proposed")
  decisionNote String?   @map("decision_note")
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  cycle    PayoutPlanCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@map("payout_plan_items")
}

/// Wave 3 E14 gap closure ("ESOPs") — grant + vesting-schedule tracking only.
/// Vested units are always computed live from grantDate/vestingStartDate/
/// vestingYears/cliffMonths (standard monthly-linear-with-cliff vesting),
/// never stored — same "live computation, no snapshot" discipline used
/// throughout this build. No exercise/transaction ledger or cap-table
/// integration: that needs finance-system infrastructure this build doesn't have.
model EsopGrant {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  totalUnits       Int      @map("total_units")
  grantDate        DateTime @map("grant_date") @db.Date
  vestingStartDate DateTime @map("vesting_start_date") @db.Date
  vestingYears     Int      @map("vesting_years")
  cliffMonths      Int      @default(12) @map("cliff_months")
  exercisePrice    Float?   @map("exercise_price")

  /// Active | Cancelled
  status String @default("Active")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("esop_grants")
}

/// v1 slice of 04-benefits-administration.md + 05-flexible-benefits.md,
/// deliberately built as one coherent vertical rather than two parallel
/// entity families. Collapses eligibility rules, dependent management,
/// life events, vendor batches, and proof/reimbursement tracking — no real
/// vendor or payroll-file integration point exists in this environment, and
/// dependents stay a Wave-1 deferral (see EmergencyContact's comment).
/// category "FlexAllowance" plans (e.g. meal/fuel/telecom) are the flexible-
/// benefits slice: an employee allocates an annual amount up to
/// maxAnnualAllocation, validated against FlexBasketPolicy. Enrolling in any
/// plan creates a real PayComponent + EmployeePayComponent assignment
/// (reusing the Payroll engine from E09) rather than a separate deduction
/// mechanism — a Deduction component for employeeCost on standard benefits,
/// an Earning component for the monthly allocation on flex options — so
/// benefit elections genuinely change the next payroll run.
model BenefitPlan {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  /// Insurance | Retirement | Wellness | FlexAllowance
  category String

  employerCost Float @default(0) @map("employer_cost")
  employeeCost Float @default(0) @map("employee_cost")

  /// Only meaningful for category = FlexAllowance — the annual cap an employee may allocate to this option.
  maxAnnualAllocation Float? @map("max_annual_allocation")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  enrollments BenefitEnrollment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("benefit_plans")
}

/// Collapses the spec's 8-state model (draft/open-for-enrollment/submitted/
/// pending-proof/approved/active/suspended/terminated) to 3 — an enrollment
/// is Enrolled immediately (no proof/approval gate), Waived, or Terminated.
model BenefitEnrollment {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  benefitPlanId String @map("benefit_plan_id") @db.Uuid

  /// Enrolled | Waived | Terminated
  status        String   @default("Enrolled")
  effectiveDate DateTime @map("effective_date") @db.Date

  /// Only set for FlexAllowance plans — the employee's chosen annual allocation; monthly payroll amount = this / 12.
  allocatedAmount Float? @map("allocated_amount")

  waiverReason String?   @map("waiver_reason")
  terminatedAt DateTime? @map("terminated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  benefitPlan BenefitPlan @relation(fields: [benefitPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, employeeId, benefitPlanId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("benefit_enrollments")
}

/// One row per tenant — the flex basket's total annual cap. No per-grade or
/// per-legal-entity variation (the spec's segmentation), since a single
/// tenant-wide policy is enough to prove the allocation-cap validation works.
model FlexBasketPolicy {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @unique @map("tenant_id") @db.Uuid
  annualAmount Float  @map("annual_amount")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("flex_basket_policies")
}

/// Wave 4 slice of docs/08-submodule-specifications/17-expense-management/01-expense-claims.md
/// and 02-reimbursements.md. Single-line claims only (category + amount +
/// date), not multi-line expense reports — no receipts/OCR, no policy/budget/
/// duplicate/fraud checks, no multi-currency (tenant-currency only), no
/// separate finance-review stage beyond manager approval, and no settlement
/// batching/channel-routing/netting/reconciliation. Collapses the claim
/// spec's 9-state model (Draft/Submitted/Under Approval/Sent Back/Finance
/// Review/Approved/Rejected/Paid/Closed) to 5 (Pending/Approved/Rejected/
/// Paid/Cancelled) and stands in for the entire Reimbursements submodule
/// with a single admin "mark paid" action instead of payable/batch/channel
/// machinery. Approval permission pattern mirrors LeaveRequest exactly.
model ExpenseClaim {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("ExpenseClaimEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  category        String
  amount          Float
  expenseDate     DateTime @map("expense_date") @db.Date
  merchant        String?
  businessPurpose String?  @map("business_purpose")

  /// Wave 3 W4·E16 gap closure ("travel expense settlement") — an optional
  /// link so a trip's expense claims can be reconciled live against its
  /// travel advances. Null for non-travel expenses.
  travelRequestId String?        @map("travel_request_id") @db.Uuid
  travelRequest   TravelRequest? @relation(fields: [travelRequestId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Pending | Approved | Rejected | Paid | Cancelled
  status String @default("Pending")

  approverId String?   @map("approver_id") @db.Uuid
  approver   Employee? @relation("ExpenseClaimApprover", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid

  paidAt DateTime? @map("paid_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, approverId])
  @@index([tenantId, travelRequestId])
  @@map("expense_claims")
}

/// Wave 4 slice of docs/08-submodule-specifications/16-travel-management/01-travel-requests.md.
/// A single flat trip request (no itinerary segments, cost-estimate lines, or
/// policy-exception sub-entities), no visa/passport/insurance prerequisite
/// checks, no destination-risk or leave-overlap validation, no travel-desk or
/// booking-tool integration, and no linkage to travel advances or expense
/// claims. Collapses the spec's 7-state model (Draft/Submitted/Under Review/
/// Approved/Booking-Ready/Cancelled/Closed) to 5 (Pending/Approved/Rejected/
/// Cancelled/Completed) and stands in for the entire booking/travel-desk
/// downstream flow with a single admin "mark completed" action, mirroring
/// ExpenseClaim's "mark paid" stand-in for Reimbursements. Approval
/// permission pattern mirrors LeaveRequest/ExpenseClaim exactly.
model TravelRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("TravelRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Business | Training | ClientVisit | Relocation | Emergency
  tripType      String   @map("trip_type")
  origin        String
  destination   String
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  estimatedCost Float?   @map("estimated_cost")
  purpose       String?

  /// Pending | Approved | Rejected | Cancelled | Completed
  status String @default("Pending")

  approverId String?   @map("approver_id") @db.Uuid
  approver   Employee? @relation("TravelRequestApprover", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  itinerarySegments TravelItinerarySegment[]
  advances          TravelAdvance[]
  expenseClaims     ExpenseClaim[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, approverId])
  @@map("travel_requests")
}

/// Wave 3 W4·E16 gap closure ("trip planning" + "itinerary") — one model
/// covers both: planning a trip IS building its leg-by-leg itinerary. No
/// booking-tool integration — bookingReference is free-text the employee
/// fills in after booking elsewhere, not a live vendor lookup.
model TravelItinerarySegment {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  travelRequestId String @map("travel_request_id") @db.Uuid

  sequence Int

  /// Flight | Train | Bus | Car | Hotel | Other
  mode String

  fromLocation String    @map("from_location")
  toLocation   String    @map("to_location")
  departAt     DateTime  @map("depart_at") @db.Timestamptz(6)
  arriveAt     DateTime? @map("arrive_at") @db.Timestamptz(6)

  bookingReference String? @map("booking_reference")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  travelRequest TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, travelRequestId])
  @@map("travel_itinerary_segments")
}

/// Wave 3 W4·E16 gap closure ("travel advances") — a cash-advance request
/// against an approved trip. No repayment schedule (unlike LoanAdvance/E09):
/// reconciliation happens once, at settlement, against the trip's linked
/// expense claims (see TravelSettlementService), not via recurring payroll
/// deduction.
model TravelAdvance {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  travelRequestId String   @map("travel_request_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  requestedAmount Float  @map("requested_amount")
  approvedAmount  Float? @map("approved_amount")

  /// Requested | Approved | Rejected | Disbursed
  status String @default("Requested")

  decisionNote    String?   @map("decision_note")
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  disbursedAt     DateTime? @map("disbursed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  travelRequest TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, travelRequestId])
  @@index([tenantId, employeeId])
  @@map("travel_advances")
}

/// Wave 4 slice of docs/08-submodule-specifications/18-asset-management/01-asset-assignment.md
/// and 02-asset-return.md. A flat asset catalog with a single current-status
/// field (no reservation/eligibility/kit-issue machinery, no high-value
/// approval routing, no digital-acknowledgment capture) and a flat assignment
/// record collapsing both specs' state machines: Assignment's 8-state model
/// (Requested/Approved/Reserved/Issued/Acknowledged/Transferred/Cancelled/
/// Closed) and Return's 7-state model (Initiated/Scheduled/Received/Under
/// Inspection/Recovery Pending/Closed/Reopened) both collapse into a single
/// Assigned -> Returned transition. No transfer/reassignment, no partial or
/// multi-item kit returns, no inspection/photo-evidence workflow, no
/// recovery-case or waiver approval chain — "returnCondition" captures the
/// outcome in one field instead. Admin-driven (org_admin/hr_ops assign and
/// process returns directly) rather than an employee-request-and-approve
/// flow, since the spec itself frames this as an IT/Workplace-Ops-operated
/// process, not a self-service one — the only self-service surface is a
/// read-only "My Assets" view.
model Asset {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  assetTag String @map("asset_tag")
  category String
  name     String

  /// Available | Assigned | UnderRepair | Retired
  status String @default("Available")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  assignments AssetAssignment[]

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@map("assets")
}

model AssetAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  assetId String @map("asset_id") @db.Uuid
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid

  /// Assigned | Returned
  status String @default("Assigned")

  returnedAt      DateTime? @map("returned_at") @db.Timestamptz(6)
  returnCondition String?   @map("return_condition")
  notes           String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, assetId])
  @@map("asset_assignments")
}

/// Wave 1 deepening pass of docs/08-submodule-specifications/01-organization-management/05-reporting-structure.md.
/// Employee.managerId (already in production use for every approval flow in
/// this build) remains the primary reporting line. This model covers only
/// the *additional* lines the spec calls out — dotted-line, matrix, and
/// acting-manager assignments — collapsing its 5-state model
/// (Draft/Scheduled/Active/Superseded/Cancelled) to a flat Active/Ended
/// status with start/end dates. No manager-hierarchy snapshot table.
model ReportingLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation("ReportingLineEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  managerId String   @map("manager_id") @db.Uuid
  manager   Employee @relation("ReportingLineManager", fields: [managerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Dotted | Matrix | Acting
  lineType String @map("line_type")

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  notes     String?

  /// Active | Ended
  status String @default("Active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, managerId])
  @@map("reporting_lines")
}

/// Wave 1 deepening pass — job family (docs/.../01-organization-management, no dedicated deep spec). Flat reference catalog.
model JobFamily {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   String @default("Active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  jobFunctions JobFunction[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("job_families")
}

/// Wave 1 deepening pass — job function. Flat reference catalog, optionally grouped under a job family.
model JobFunction {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   String @default("Active")

  jobFamilyId String?    @map("job_family_id") @db.Uuid
  jobFamily   JobFamily? @relation(fields: [jobFamilyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  designations Designation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("job_functions")
}

/// Wave 1 deepening pass — designation, with career track folded in as a plain field rather than a separate model.
model Designation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  title    String
  status   String @default("Active")

  jobFunctionId String?      @map("job_function_id") @db.Uuid
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// IC | Managerial
  careerTrack String @default("IC") @map("career_track")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  positions                 Position[]
  employees                 Employee[]
  transferPromotionRequests TransferPromotionRequest[]
  careerPlans               CareerPlan[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("designations")
}

/// Wave 1 deepening pass of docs/08-submodule-specifications/01-organization-management/07-grade-and-band.md.
/// Band is folded into a plain field rather than a separate model/mapping
/// table; no harmonization map or assignment-history table.
model Grade {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  band     String?
  status   String  @default("Active")

  minCompensation Float? @map("min_compensation")
  maxCompensation Float? @map("max_compensation")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  employees                 Employee[]
  transferPromotionRequests TransferPromotionRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("grades")
}

/// Wave 1 deepening pass — position management. This sub-capability has no
/// dedicated spec file at all (a real catalog gap, not a collapsed spec); the
/// model below follows common HRIS practice: a budgeted seat in a
/// department, optionally linked to a designation/grade, that an employee
/// may occupy (via Employee.positionId) — no headcount-budget ledger or
/// requisition linkage yet.
model Position {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  title    String

  /// Open | Filled | Frozen | Closed
  status String @default("Open")

  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  designationId String?      @map("designation_id") @db.Uuid
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@map("positions")
}

/// Wave 1 deepening pass of docs/08-submodule-specifications/01-organization-management/09-work-calendar.md.
/// Holiday calendar folds in as WorkCalendarDay rows with dayType=Holiday —
/// no separate holiday-calendar entity. Collapses the 5-state model
/// (Draft/Published/Future Effective/Superseded/Retired) to Draft/Published/Retired.
model WorkCalendar {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String

  /// Draft | Published | Retired
  status String @default("Draft")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  days        WorkCalendarDay[]
  assignments WorkCalendarAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("work_calendars")
}

model WorkCalendarDay {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  calendarId String       @map("calendar_id") @db.Uuid
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  date DateTime @map("date_iso") @db.Date

  /// Working | Holiday | Weekend | Shutdown
  dayType String  @map("day_type")
  label   String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([calendarId, date])
  @@index([tenantId])
  @@index([tenantId, calendarId])
  @@map("work_calendar_days")
}

/// Which calendar applies to which scope — Tenant-wide (scopeId null), a LegalEntity, or a Department.
model WorkCalendarAssignment {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  calendarId String       @map("calendar_id") @db.Uuid
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Tenant | LegalEntity | Department
  scope   String  @default("Tenant")
  scopeId String? @map("scope_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, scope, scopeId])
  @@map("work_calendar_assignments")
}

/// Wave 1 deepening pass — organization policies. This sub-capability has no
/// dedicated spec file; modeled as a minimal policy-document registry (title
/// + content + category + effective date), not a rules/versioning/acknowledgment engine.
model OrgPolicy {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  category String
  title    String
  content  String

  /// Active | Archived
  status        String   @default("Active")
  effectiveFrom DateTime @map("effective_from") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("org_policies")
}

/// Wave 1 People Management deepening pass, docs/08-submodule-specifications/02-people-management/02-personal-information.md.
/// Collapses employee_personal_profile + employee_contact_detail (the
/// change-request/demographic-history sidecar tables are dropped) into one
/// 1:1 record with direct self-service edit — no approval workflow. Also
/// folds in the "contact details and address" catalog item, which the spec
/// treats as part of the same personal-information domain.
model PersonalDetail {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @unique @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  maritalStatus String? @map("marital_status")
  gender        String?
  bloodGroup    String? @map("blood_group")
  nationality   String?

  currentAddressLine String? @map("current_address_line")
  currentCity        String? @map("current_city")
  currentState       String? @map("current_state")
  currentCountry     String? @map("current_country")
  currentPincode     String? @map("current_pincode")

  /// When true, permanent address fields are ignored and current-address fields are used for both.
  permanentSameAsCurrent Boolean @default(true) @map("permanent_same_as_current")
  permanentAddressLine   String? @map("permanent_address_line")
  permanentCity          String? @map("permanent_city")
  permanentState         String? @map("permanent_state")
  permanentCountry       String? @map("permanent_country")
  permanentPincode       String? @map("permanent_pincode")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("personal_details")
}

/// Part of docs/.../02-personal-information.md's "family/dependents/nominees/emergency contacts"
/// catalog item — emergency contacts only. Dependents and insurance/PF
/// nominees are explicitly deferred (no dependent-relationship or nomination
/// entity yet).
model EmergencyContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("emergency_contacts")
}

/// Wave 1 People Management deepening pass, consolidating 2 catalog items —
/// national identity (docs/.../04-national-identity.md) and "passport, visa,
/// driving license" — into one type-tagged document table, same pattern as
/// OrgUnit/Asset elsewhere in this build. No verification workflow,
/// expiry-alerting, or field-level encryption/masking (see this phase's
/// disclosed security-depth gap) — just the record and its expiry date.
model IdentityDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// PAN | Aadhaar | Passport | DrivingLicense | VoterID | NationalID | Visa | Other
  documentType   String    @map("document_type")
  documentNumber String    @map("document_number")
  issuingCountry String?   @map("issuing_country")
  expiryDate     DateTime? @map("expiry_date") @db.Date

  /// Active | Expired | Verified | Pending
  status String @default("Pending")

  /// Optional scan/photo of the physical document, via the File Storage engine.
  fileId String?     @map("file_id") @db.Uuid
  file   StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("identity_documents")
}

/// Wave 1 People Management deepening pass, docs/.../06-bank-accounts.md.
/// Collapses bank_account_verification/change_request/country_format_rule
