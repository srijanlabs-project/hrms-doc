  leaveEncashmentRequests     LeaveEncashmentRequest[]
  loanAdvances                LoanAdvance[]
  incentiveBonuses            IncentiveBonus[]
  reportDefinitions           ReportDefinition[]
  featureFlags                FeatureFlag[]
  consentRecords              ConsentRecord[]
  candidateAssessments        CandidateAssessment[]
  rewardCatalogItems          RewardCatalogItem[]
  rewardRedemptions           RewardRedemption[]
  communities                 Community[]
  communityMemberships        CommunityMembership[]
  feedPosts                   FeedPost[]
  feedComments                FeedComment[]
  feedLikes                   FeedLike[]
  experienceEvents            ExperienceEvent[]
  eventRsvps                  EventRsvp[]
  announcementComments        AnnouncementComment[]
