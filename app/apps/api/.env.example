# Copy to .env and adjust. Local dev uses the staffsy role created by scripts/db-setup.sql.
DATABASE_URL="postgresql://staffsy:staffsy_dev@localhost:5432/staffsy?schema=public"
PORT=3000

# Shared secret for the tenant-provisioning bootstrap endpoint (POST /platform/tenants).
# Falls back to a dev-only default if unset — always set a real value in production.
PLATFORM_PROVISIONING_KEY="change-me"
