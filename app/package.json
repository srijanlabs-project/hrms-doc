{
  "name": "staffsy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @staffsy/web",
    "dev:api": "npm run dev --workspace @staffsy/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "esbuild@0.25.12": true
  }
}
